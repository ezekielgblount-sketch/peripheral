(event EventBeginPlay
  (Variables|Default|SetHomeLoc (Transformation|GetActorLocation))
  (Variables|Default|SetHomeRot (Transformation|GetActorRotation)))

; States: 0 dormant (waiting to be noticed), 1 armed, 2 changed, 3 spent (cooling down).
; It only changes while it is NOT being looked at, and snaps back after 0.12 s of direct focus.
(event EventTick (DeltaSeconds)
  (bind pcm (Game|GetPlayerCameraManager :PlayerIndex 0))
  (bind camLoc (Camera|GetCameraLocation :self pcm))
  (bind fwd (Math|Vector|GetForwardVector :InRot (Camera|GetCameraRotation :self pcm)))
  (bind to (- (+ (Transformation|GetActorLocation) (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 8.0)) camLoc))
  (bind dist (+ (Math|Vector|VectorLength :A to) 0.001))
  (bind ang (Math|Trig|Acos(Degrees) :A (/ (Math|Vector|DotProduct :A fwd :B to) dist)))
  (bind (hit blocked) (Collision|LineTraceByChannel :Start camLoc :End (+ camLoc (* to (/ (- dist 7.0) dist)))))
  (bind state (Variables|Default|GetState))
  (bind timer (Variables|Default|GetTimer))
  (bind near (< dist (Variables|Default|GetRange)))
  (bind comp (Variables|StaticMeshActor|GetStaticMeshComponent))
  (if (== state 0)
    (bind t0 (select (and near (and (< ang 28.0) (not blocked))) (+ timer DeltaSeconds) timer))
    (Variables|Default|SetTimer t0)
    (if (> t0 (Variables|Default|GetArmTime))
      (Variables|Default|SetState 1)
      (Variables|Default|SetTimer 0.0))
    (elif (== state 1)
      (if (and near (or (> ang 40.0) blocked))
        (Components|StaticMesh|SetStaticMesh :self comp :NewMesh (Variables|Default|GetAltMesh))
        (bind hr (Variables|Default|GetHomeRot))
        (Transformation|SetActorLocationAndRotation
          :NewLocation (+ (Variables|Default|GetHomeLoc) (Variables|Default|GetAltOffset))
          :NewRotation (Math|Rotator|MakeRotator :Roll (.roll hr) :Pitch (.pitch hr) :Yaw (+ (.yaw hr) (Variables|Default|GetAltYaw))))
        (Variables|Default|SetState 2)
        (Variables|Default|SetTimer 0.0))
      (elif (== state 2)
        (bind t2 (select (and (< ang 11.0) (not blocked)) (+ timer DeltaSeconds) 0.0))
        (Variables|Default|SetTimer t2)
        (if (>= t2 0.12)
          (Components|StaticMesh|SetStaticMesh :self comp :NewMesh (Variables|Default|GetHomeMesh))
          (Transformation|SetActorLocationAndRotation :NewLocation (Variables|Default|GetHomeLoc) :NewRotation (Variables|Default|GetHomeRot))
          (Variables|Default|SetState 3)
          (Variables|Default|SetTimer 0.0)
          (Variables|Default|SetCooldown (Math|Random|RandomFloatinRange :Min 60.0 :Max 120.0)))
        (else
          (Variables|Default|SetTimer (+ timer DeltaSeconds))
          (if (> timer (Variables|Default|GetCooldown))
            (Variables|Default|SetState 0)
            (Variables|Default|SetTimer 0.0)))))))
