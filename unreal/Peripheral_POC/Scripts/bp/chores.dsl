(event EventBeginPlay
  (bind f_CB (Actor|GetAllActorswithTag :Tag "cb"))
  (for a_CB f_CB (Variables|Default|SetCB a_CB))
  (bind f_CP (Actor|GetAllActorswithTag :Tag "cp"))
  (for a_CP f_CP (Variables|Default|SetCP a_CP))
  (bind f_Mower (Actor|GetAllActorswithTag :Tag "ch_mower"))
  (for a_Mower f_Mower (Variables|Default|SetMower a_Mower))
  (bind f_Bin (Actor|GetAllActorswithTag :Tag "ch_bin"))
  (for a_Bin f_Bin (Variables|Default|SetBin a_Bin))
  (bind f_Bag (Actor|GetAllActorswithTag :Tag "ch_bag"))
  (for a_Bag f_Bag (Variables|Default|SetBag a_Bag))
  (bind f_Mailbox (Actor|GetAllActorswithTag :Tag "ch_mailbox"))
  (for a_Mailbox f_Mailbox (Variables|Default|SetMailbox a_Mailbox))
  (bind f_MailboxOpen (Actor|GetAllActorswithTag :Tag "ch_mailbox_open"))
  (for a_MailboxOpen f_MailboxOpen (Variables|Default|SetMailboxOpen a_MailboxOpen))
  (bind f_Mail (Actor|GetAllActorswithTag :Tag "ch_mail"))
  (for a_Mail f_Mail (Variables|Default|SetMail a_Mail))
  (bind f_Washer (Actor|GetAllActorswithTag :Tag "ch_washer"))
  (for a_Washer f_Washer (Variables|Default|SetWasher a_Washer))
  (bind f_Dryer (Actor|GetAllActorswithTag :Tag "ch_dryer"))
  (for a_Dryer f_Dryer (Variables|Default|SetDryer a_Dryer))
  (bind f_Clothes (Actor|GetAllActorswithTag :Tag "ch_clothes"))
  (for a_Clothes f_Clothes (Variables|Default|SetClothes a_Clothes))
  (bind f_Can (Actor|GetAllActorswithTag :Tag "ch_can"))
  (for a_Can f_Can (Variables|Default|SetCan a_Can))
  (bind f_Broom (Actor|GetAllActorswithTag :Tag "ch_broom"))
  (for a_Broom f_Broom (Variables|Default|SetBroom a_Broom))
  (bind f_BulbBox (Actor|GetAllActorswithTag :Tag "ch_bulb"))
  (for a_BulbBox f_BulbBox (Variables|Default|SetBulbBox a_BulbBox))
  (bind f_Bed (Actor|GetAllActorswithTag :Tag "ch_bed"))
  (for a_Bed f_Bed (Variables|Default|SetBed a_Bed))
  (bind f_BedMade (Actor|GetAllActorswithTag :Tag "ch_bed_made"))
  (for a_BedMade f_BedMade (Variables|Default|SetBedMade a_BedMade))
  (bind f_Rack (Actor|GetAllActorswithTag :Tag "ch_rack"))
  (for a_Rack f_Rack (Variables|Default|SetRack a_Rack))
  (bind f_HallSwitch (Actor|GetAllActorswithTag :Tag "ch_hall_switch"))
  (for a_HallSwitch f_HallSwitch (Variables|Default|SetHallSwitch a_HallSwitch))
  (bind plates0 (Actor|GetAllActorswithTag :Tag "ch_plate"))
  (for p0 plates0 (Variables|Default|SetSinkLoc (Transformation|GetActorLocation :self p0)) (break))
  (Variables|Default|SetWasherHome (Transformation|GetActorLocation :self (Variables|Default|GetWasher)))
  (Variables|Default|SetDryerHome (Transformation|GetActorLocation :self (Variables|Default|GetDryer)))
  (Variables|Default|SetMowSnd (Audio|SpawnSound2D :Sound "/Game/Audio/mower_loop.mower_loop" :VolumeMultiplier 0.55 :bAutoDestroy false))
  (Variables|Default|SetWashSnd (Audio|SpawnSound2D :Sound "/Game/Audio/washer_loop.washer_loop" :VolumeMultiplier 0.5 :bAutoDestroy false))
  (Variables|Default|SetDrySnd (Audio|SpawnSound2D :Sound "/Game/Audio/dryer_loop.dryer_loop" :VolumeMultiplier 0.5 :bAutoDestroy false))
  (Variables|Default|SetPourSnd (Audio|SpawnSound2D :Sound "/Game/Audio/water_pour.water_pour" :VolumeMultiplier 0.5 :bAutoDestroy false))
  (Audio|Components|Audio|SetPaused :self (Variables|Default|GetMowSnd) :bPause true)
  (Audio|Components|Audio|SetPaused :self (Variables|Default|GetWashSnd) :bPause true)
  (Audio|Components|Audio|SetPaused :self (Variables|Default|GetDrySnd) :bPause true)
  (Audio|Components|Audio|SetPaused :self (Variables|Default|GetPourSnd) :bPause true)
  (bind pl0 (Utilities|Casting|CastToBP_Player :Object (Game|GetPlayerPawn :PlayerIndex 0))
    (:then (Variables|Default|SetPlayerRef pl0))
    (:CastFailed)))

(event EventTick (DeltaSeconds)
  (bind cb (Variables|Default|GetCB))
  (bind cbl (Transformation|GetActorLocation :self cb))
  (bind pl (Variables|Default|GetPlayerRef))
  (bind pc (Game|GetPlayerController :PlayerIndex 0))
  (bind ploc (Transformation|GetActorLocation :self pl))
  (bind now (Utilities|Time|GetGameTimeinSeconds))
  (bind active (> (.y cbl) 0.5))
  ; TestUse lets a script press "use" for a play-mode test
  (bind use (and active (or (Variables|Default|GetTestUse) (and (Game|Player|WasInputKeyJustPressed :self pc :Key (Class|BPPlayer|GetKUse :self pl)) (not (Input|IsMoveInputIgnored :self pc))))))
  (bind held (Class|BPPlayer|GetHeld :self pl))
  (bind carrying (Class|BPPlayer|GetCarrying :self pl))
  (bind pushing (Class|BPPlayer|GetPushing :self pl))
  ; ---------------- 0. mow the lawn: the long grass is cut short wherever the mower passes ----------------
  (bind mowing (and active (and pushing (== held (Variables|Default|GetMower)))))
  (Audio|Components|Audio|SetPaused :self (Variables|Default|GetMowSnd) :bPause (not mowing))
  (if mowing
    (bind mloc (Transformation|GetActorLocation :self (Variables|Default|GetMower)))
    (bind grass (Actor|GetAllActorswithTag :Tag "grass"))
    (Variables|Default|SetLeft 0)
    (for g grass
      (if (> (.z (Transformation|GetActorScale3D :self g)) 0.5)
        (if (< (Math|Vector|Distance2D(Vector) :V1 (Transformation|GetActorLocation :self g) :V2 mloc) 78.0)
          (Transformation|SetActorScale3D :self g :NewScale3D (Math|Vector|MakeVector :X 1.0 :Y 1.0 :Z 0.16))
          (else (Variables|Default|SetLeft (+ (Variables|Default|GetLeft) 1))))))
    (if (and (< (Variables|Default|GetLeft) 3) (not (Variables|Default|GetD0))) (Variables|Default|SetD0 true) (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.5))
    (if (> (- now (Variables|Default|GetCapT)) 4.0) (Variables|Default|SetCapT now) (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 1.0 :Y now :Z 0.0))))
  ; the day can ask for one strip to grow back (request 2)
  (if (and (> (.z cbl) 1.5) (< (.z cbl) 2.5))
    (bind strip (Actor|GetAllActorswithTag :Tag "grass_s3"))
    (for gs strip (Transformation|SetActorScale3D :self gs :NewScale3D (Math|Vector|MakeVector :X 1.0 :Y 1.0 :Z 1.0)))
    (Transformation|SetActorLocation :self cb :NewLocation (Math|Vector|MakeVector :X (.x cbl) :Y (.y cbl) :Z 0.0)))
  ; ---------------- 1. trash: bag into the wheeled bin, bin to the curb ----------------
  (if (and active (== (Variables|Default|GetTrashS) 0))
    (if (< (Math|Vector|Distance2D(Vector) :V1 (Transformation|GetActorLocation :self (Variables|Default|GetBag)) :V2 (Transformation|GetActorLocation :self (Variables|Default|GetBin))) 115.0)
      (Rendering|SetActorHiddenInGame :self (Variables|Default|GetBag) :bNewHidden true)
      (Collision|SetActorEnableCollision :self (Variables|Default|GetBag) :bNewActorEnableCollision false)
      (Class|BPPlayer|SetCarrying :self pl :Carrying false)
      (Audio|PlaySound2D :Sound "/Game/Audio/box_thump.box_thump" :VolumeMultiplier 0.7)
      (Variables|Default|SetTrashS 1)))
  (if (and active (== (Variables|Default|GetTrashS) 1))
    (if (and (< (Math|Vector|Distance2D(Vector) :V1 (Transformation|GetActorLocation :self (Variables|Default|GetBin)) :V2 (Math|Vector|MakeVector :X -1575.0 :Y 550.0 :Z 0.0)) 230.0) (not (and pushing (== held (Variables|Default|GetBin)))))
      (Variables|Default|SetTrashS 2) (Variables|Default|SetD1 true) (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.5)))
  ; ---------------- 2. mail: open the box, carry the mail indoors ----------------
  (if (and use (and (== (Variables|Default|GetMailS) 0) (< (Math|Vector|Distance2D(Vector) :V1 ploc :V2 (Transformation|GetActorLocation :self (Variables|Default|GetMailbox))) 190.0)))
    (Rendering|SetActorHiddenInGame :self (Variables|Default|GetMailbox) :bNewHidden true) (Rendering|SetActorHiddenInGame :self (Variables|Default|GetMailboxOpen) :bNewHidden false) (Rendering|SetActorHiddenInGame :self (Variables|Default|GetMail) :bNewHidden false)
    (Audio|PlaySound2D :Sound "/Game/Audio/mailbox.mailbox" :VolumeMultiplier 0.7)
    (Variables|Default|SetMailS 1))
  (if (and active (== (Variables|Default|GetMailS) 1))
    (if (> (.x (Transformation|GetActorLocation :self (Variables|Default|GetMail))) -430.0) (Variables|Default|SetMailS 2) (Variables|Default|SetD2 true) (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.5)))
  ; ---------------- 3. dishes: one plate per press, from the sink to the rack ----------------
  (bind dn (Variables|Default|GetDishN))
  (if (and use (and (< dn 5) (and (< (Math|Vector|Distance2D(Vector) :V1 ploc :V2 (Variables|Default|GetSinkLoc)) 150.0) (> (- now (Variables|Default|GetUseT)) 0.7))))
    (bind plates (Actor|GetAllActorswithTag :Tag "ch_plate"))
    (bind clean (Actor|GetAllActorswithTag :Tag "ch_plate_clean"))
    (Rendering|SetActorHiddenInGame :self (Utilities|Array|Get(acopy) :Array plates :"Dimension 1" (- 4 dn)) :bNewHidden true)
    (Rendering|SetActorHiddenInGame :self (Utilities|Array|Get(acopy) :Array clean :"Dimension 1" dn) :bNewHidden false)
    (Audio|PlaySound2D :Sound "/Game/Audio/dish_wash.dish_wash" :VolumeMultiplier 0.7) (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 5.0 :Y now :Z 0.0))
    (Variables|Default|SetUseT now)
    (Variables|Default|SetDishN (+ dn 1))
    (if (== dn 4) (Variables|Default|SetD3 true) (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.5)))
  ; the day can put the washed dishes back in the sink (request 1)
  (if (and (> (.z cbl) 0.5) (< (.z cbl) 1.5))
    (bind plates2 (Actor|GetAllActorswithTag :Tag "ch_plate"))
    (for p2 plates2 (Rendering|SetActorHiddenInGame :self p2 :bNewHidden false))
    (bind clean2 (Actor|GetAllActorswithTag :Tag "ch_plate_clean"))
    (for c2 clean2 (Rendering|SetActorHiddenInGame :self c2 :bNewHidden true))
    (Variables|Default|SetDishN 0)
    (Transformation|SetActorLocation :self cb :NewLocation (Math|Vector|MakeVector :X (.x cbl) :Y (.y cbl) :Z 0.0)))
  ; ---------------- 4. laundry: washer, then dryer ----------------
  (bind ls (Variables|Default|GetLaunS))
  (bind nearW (< (Math|Vector|Distance2D(Vector) :V1 ploc :V2 (Variables|Default|GetWasherHome)) 175.0))
  (if (and use (and (== ls 0) nearW))
    (Rendering|SetActorHiddenInGame :self (Variables|Default|GetClothes) :bNewHidden true) (Audio|PlaySound2D :Sound "/Game/Audio/cloth.cloth" :VolumeMultiplier 0.7) (Variables|Default|SetLaunS 1) (Variables|Default|SetLaunT 0.0))
  (if (and use (and (== ls 2) nearW))
    (Audio|PlaySound2D :Sound "/Game/Audio/cloth.cloth" :VolumeMultiplier 0.7) (Variables|Default|SetLaunS 3) (Variables|Default|SetLaunT 0.0) (Variables|Default|SetD4 true))
  (Audio|Components|Audio|SetPaused :self (Variables|Default|GetWashSnd) :bPause (!= ls 1))
  (Audio|Components|Audio|SetPaused :self (Variables|Default|GetDrySnd) :bPause (!= ls 3))
  (if (or (== ls 1) (== ls 3))
    (bind lt (+ (Variables|Default|GetLaunT) DeltaSeconds))
    (Variables|Default|SetLaunT lt)
    (bind shake (Math|Vector|MakeVector :X (* 0.5 (Math|Trig|Sin(Radians) (* now 41.0))) :Y (* 0.4 (Math|Trig|Sin(Radians) (* now 53.0))) :Z 0.0))
    (if (== ls 1)
      (Transformation|SetActorLocation :self (Variables|Default|GetWasher) :NewLocation (+ (Variables|Default|GetWasherHome) shake))
      (else (Transformation|SetActorLocation :self (Variables|Default|GetDryer) :NewLocation (+ (Variables|Default|GetDryerHome) shake))))
    (if (and (< lt 0.3) active) (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 2.0 :Y now :Z 0.0)))
    (if (> lt 18.0)
      (Audio|PlaySound2D :Sound "/Game/Audio/buzzer.buzzer" :VolumeMultiplier 0.5) (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 3.0 :Y now :Z 0.0))
      (Variables|Default|SetLaunS (+ ls 1))))
  ; ---------------- 5. water the garden: stand at each dry patch with the can ----------------
  (bind wn (Variables|Default|GetWaterN))
  (if (and active (and (< wn 3) (and carrying (== held (Variables|Default|GetCan)))))
    (bind dry (Actor|GetAllActorswithTag :Tag "ch_soil"))
    (bind patch (Utilities|Array|Get(acopy) :Array dry :"Dimension 1" wn))
    (if (< (Math|Vector|Distance2D(Vector) :V1 ploc :V2 (Transformation|GetActorLocation :self patch)) 175.0)
      (bind wt (+ (Variables|Default|GetWaterT) DeltaSeconds))
      (Variables|Default|SetWaterT wt)
      (Audio|Components|Audio|SetPaused :self (Variables|Default|GetPourSnd) :bPause false)
      (if (< wt 0.1) (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 4.0 :Y now :Z 0.0)))
      (if (> wt 2.2)
        (bind wet (Actor|GetAllActorswithTag :Tag "ch_soil_wet"))
        (Rendering|SetActorHiddenInGame :self patch :bNewHidden true)
        (Rendering|SetActorHiddenInGame :self (Utilities|Array|Get(acopy) :Array wet :"Dimension 1" wn) :bNewHidden false)
        (Variables|Default|SetWaterN (+ wn 1)) (Variables|Default|SetWaterT 0.0)
        (if (== wn 2) (Variables|Default|SetD5 true) (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.5)))
      (else (Audio|Components|Audio|SetPaused :self (Variables|Default|GetPourSnd) :bPause true)))
    (else (Audio|Components|Audio|SetPaused :self (Variables|Default|GetPourSnd) :bPause true)))
  ; ---------------- 6. sweep the garage: push the broom through each pile ----------------
  (if (and active (and pushing (== held (Variables|Default|GetBroom))))
    (bind bl (Transformation|GetActorLocation :self (Variables|Default|GetBroom)))
    (bind dust (Actor|GetAllActorswithTag :Tag "ch_dust"))
    (Variables|Default|SetLeft 0)
    (for d dust
      (if (> (.z (Transformation|GetActorScale3D :self d)) 0.5)
        (if (< (Math|Vector|Distance2D(Vector) :V1 (Transformation|GetActorLocation :self d) :V2 bl) 62.0)
          (Transformation|SetActorScale3D :self d :NewScale3D (Math|Vector|MakeVector :X 0.05 :Y 0.05 :Z 0.05))
          (Rendering|SetActorHiddenInGame :self d :bNewHidden true)
          (Audio|PlaySound2D :Sound "/Game/Audio/sweep.sweep" :VolumeMultiplier 0.6)
          (else (Variables|Default|SetLeft (+ (Variables|Default|GetLeft) 1))))))
    (if (and (== (Variables|Default|GetLeft) 0) (not (Variables|Default|GetD6))) (Variables|Default|SetD6 true) (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.5)))
  ; ---------------- 7. the hall bulb: carry the new bulb under the dead fixture ----------------
  (if (and active (and (not (Variables|Default|GetD7)) (and carrying (== held (Variables|Default|GetBulbBox)))))
    (if (< (Math|Vector|Distance2D(Vector) :V1 ploc :V2 (Math|Vector|MakeVector :X -110.0 :Y -275.0 :Z 0.0)) 120.0)
      (Rendering|SetActorHiddenInGame :self (Variables|Default|GetBulbBox) :bNewHidden true)
      (Class|BPPlayer|SetCarrying :self pl :Carrying false)
      (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.8)
      (Variables|Default|SetD7 true)
      (bind sw (Utilities|Casting|CastToBP_Switch :Object (Variables|Default|GetHallSwitch))
        (:then (Class|BPSwitch|SetStage :self sw :Stage 1) (Class|BPSwitch|SetOn :self sw :On true))
        (:CastFailed))))
  ; ---------------- 8. make the bed ----------------
  (if (and use (and (not (Variables|Default|GetD8)) (< (Math|Vector|Distance2D(Vector) :V1 ploc :V2 (Transformation|GetActorLocation :self (Variables|Default|GetBed))) 200.0)))
    (Rendering|SetActorHiddenInGame :self (Variables|Default|GetBed) :bNewHidden true) (Collision|SetActorEnableCollision :self (Variables|Default|GetBed) :bNewActorEnableCollision false) (Rendering|SetActorHiddenInGame :self (Variables|Default|GetBedMade) :bNewHidden false)
    (Audio|PlaySound2D :Sound "/Game/Audio/cloth.cloth" :VolumeMultiplier 0.8)
    (Variables|Default|SetD8 true))
  ; ---------------- report: one bit per finished chore ----------------
  (bind mask (+ (+ (+ (select (Variables|Default|GetD0) 1.0 0.0) (select (Variables|Default|GetD1) 2.0 0.0)) (+ (select (Variables|Default|GetD2) 4.0 0.0) (select (Variables|Default|GetD3) 8.0 0.0)))
               (+ (+ (select (Variables|Default|GetD4) 16.0 0.0) (select (Variables|Default|GetD5) 32.0 0.0)) (+ (+ (select (Variables|Default|GetD6) 64.0 0.0) (select (Variables|Default|GetD7) 128.0 0.0)) (select (Variables|Default|GetD8) 256.0 0.0)))))
  (Variables|Default|SetTestUse false)
  (bind cb2 (Transformation|GetActorLocation :self cb))
  (Transformation|SetActorLocation :self cb :NewLocation (Math|Vector|MakeVector :X mask :Y (.y cb2) :Z (.z cb2))))
