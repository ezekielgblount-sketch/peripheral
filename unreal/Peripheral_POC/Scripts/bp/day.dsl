(event EventBeginPlay
  (bind f_CB (Actor|GetAllActorswithTag :Tag "cb")) (for a_CB f_CB (Variables|Default|SetCB a_CB))
  (bind f_DB (Actor|GetAllActorswithTag :Tag "db")) (for a_DB f_DB (Variables|Default|SetDB a_DB))
  (bind f_SB (Actor|GetAllActorswithTag :Tag "sb")) (for a_SB f_SB (Variables|Default|SetSB a_SB))
  (bind f_Sun (Actor|GetAllActorswithTag :Tag "sun")) (for a_Sun f_Sun (Variables|Default|SetSun a_Sun)))

(event EventTick (DeltaSeconds)
  (bind cbl (Transformation|GetActorLocation :self (Variables|Default|GetCB)))
  (if (and (> (.y cbl) 0.5) (not (Variables|Default|GetRunning)))
    (Variables|Default|SetRunning true) (Variables|Default|SetT 0.0) (Variables|Default|SetTryT 0.0)
    (Variables|Default|SetNextT (Math|Random|RandomFloatinRange :Min 25.0 :Max 45.0))
    (bind blk (Actor|GetAllActorswithTag :Tag "s_blocker"))
    (for b blk (Collision|SetActorEnableCollision :self b :bNewActorEnableCollision false)))
  (if (Variables|Default|GetRunning)
    (bind t (+ (Variables|Default|GetT) DeltaSeconds))
    (Variables|Default|SetT t)
    (bind pcm (Game|GetPlayerCameraManager :PlayerIndex 0))
    (bind camLoc (Camera|GetCameraLocation :self pcm))
    (bind fwd (Math|Vector|GetForwardVector :InRot (Camera|GetCameraRotation :self pcm)))
    (bind edge (+ (* 0.5 (.x (Transformation|GetActorLocation :self (Variables|Default|GetSB)))) 14.0))
    ; the sun crosses the sky over the length of the day
    (bind f (Math|Float|Clamp(Float) :Value (/ t (Variables|Default|GetDayLen)) :Min 0.0 :Max 1.0))
    (Transformation|SetActorRotation :self (Variables|Default|GetSun) :NewRotation (Math|Rotator|MakeRotator :Roll 0.0
      :Pitch (- -16.0 (* 44.0 (Math|Trig|Sin(Radians) (* f 3.14159)))) :Yaw (- 205.0 (* 185.0 f))))
    (Transformation|SetActorLocation :self (Variables|Default|GetDB) :NewLocation (Math|Vector|MakeVector :X (Variables|Default|GetMask) :Y t :Z (select (Variables|Default|GetOver) 1.0 0.0)))
    ; has the player looked straight at anything that changed?
    (bind order (Variables|Default|GetFiredOrder))
    (for i (range (Utilities|Array|Length :TargetArray order))
      (bind idx (Utilities|Array|Get(acopy) :Array order :"Dimension 1" i))
      (if (not (Utilities|Array|Get(acopy) :Array (Variables|Default|GetSeen) :"Dimension 1" idx))
        (bind st (- (Utilities|Array|Get(acopy) :Array (Variables|Default|GetProbes) :"Dimension 1" idx) camLoc))
    (bind sd (+ (Math|Vector|VectorLength :A st) 0.001))
    (bind sa (Math|Trig|Acos(Degrees) :A (/ (Math|Vector|DotProduct :A fwd :B st) sd)))
    (bind (sh sb) (Collision|LineTraceByChannel :Start camLoc :End (+ camLoc (* st (/ (- sd 30.0) sd)))))
        (if (and (and (< sa 20.0) (not sb)) (and (< sd 900.0) (> (- t (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFiredTime) :"Dimension 1" i)) 2.0)))
          (Utilities|Array|SetArrayElem :TargetArray (Variables|Default|GetSeen) :Index idx :Item true))))
    (bind chores (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_Chores.BP_Chores_C"))
    (for c chores (Variables|Default|SetDishDone (Class|BPChores|GetD3 :self c)) (Variables|Default|SetMowDone (Class|BPChores|GetD0 :self c)))
    (if (and (not (Variables|Default|GetOver)) (or (> (.x cbl) 510.5) (> t (Variables|Default|GetDayLen))))
      (Variables|Default|SetOver true)
      (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.8))
    ; ---------------- try to fire one anomaly: only somewhere the player cannot see ----------------
    (if (and (and (not (Variables|Default|GetOver)) (> t (Variables|Default|GetNextT))) (> (- t (Variables|Default|GetTryT)) 1.0))
      (Variables|Default|SetTryT t)
      (Variables|Default|SetR (Math|Random|RandomIntegerinRange :Min 0 :Max 14))
      (bind r (Variables|Default|GetR))
      (Variables|Default|SetLightOK false)
      (if (== r 9)
        (bind sws (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_Switch.BP_Switch_C"))
        (for sw sws
          (if (not (Class|BPSwitch|GetOn :self sw))
            (bind lt (- (Transformation|GetActorLocation :self sw) camLoc))
    (bind ld (+ (Math|Vector|VectorLength :A lt) 0.001))
    (bind la (Math|Trig|Acos(Degrees) :A (/ (Math|Vector|DotProduct :A fwd :B lt) ld)))
    (bind (lh lb) (Collision|LineTraceByChannel :Start camLoc :End (+ camLoc (* lt (/ (- ld 30.0) ld)))))
            (if (and (> ld 300.0) (or (> la edge) lb))
              (Variables|Default|SetLightCand sw) (Variables|Default|SetLightOK true)
              (Utilities|Array|SetArrayElem :TargetArray (Variables|Default|GetProbes) :Index 9 :Item (Transformation|GetActorLocation :self sw))))))
      (bind pt (- (Utilities|Array|Get(acopy) :Array (Variables|Default|GetProbes) :"Dimension 1" r) camLoc))
    (bind pd (+ (Math|Vector|VectorLength :A pt) 0.001))
    (bind pa (Math|Trig|Acos(Degrees) :A (/ (Math|Vector|DotProduct :A fwd :B pt) pd)))
    (bind (ph pb) (Collision|LineTraceByChannel :Start camLoc :End (+ camLoc (* pt (/ (- pd 30.0) pd)))))
      (bind unseen (and (> pd 250.0) (or (> pa edge) pb)))
      (bind ok (and (not (Utilities|Array|Get(acopy) :Array (Variables|Default|GetIsFired) :"Dimension 1" r))
                 (and (select (== r 9) (Variables|Default|GetLightOK) unseen)
                      (and (or (!= r 5) (Variables|Default|GetDishDone)) (or (!= r 6) (Variables|Default|GetMowDone))))))
      (if ok
        (Utilities|Array|SetArrayElem :TargetArray (Variables|Default|GetIsFired) :Index r :Item true)
        (Utilities|Array|Add :TargetArray (Variables|Default|GetFiredOrder) :NewItem r)
        (Utilities|Array|Add :TargetArray (Variables|Default|GetFiredTime) :NewItem t)
        (Variables|Default|SetMask (+ (Variables|Default|GetMask) (Math|Float|Power :Base 2.0 :Exp (Math|Conversions|ToFloat(Integer) r))))
        (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))
        (switch int (select (== r 4) 0 (select (== r 5) 1 (select (== r 6) 2 (select (== r 9) 3 (select (== r 10) 4 5)))))
          (:0 (bind doors (Actor|GetAllActorsOfClasswithTag :ActorClass "/Game/Blueprints/BP_Mover.BP_Mover_C" :Tag "s_pdoor"))
              (for d doors
                (bind cr (Class|BPMover|GetClosedRot :self d))
                (Class|BPMover|SetClosedRot :self d :ClosedRot (Math|Rotator|MakeRotator :Roll (.roll cr) :Pitch (.pitch cr) :Yaw (+ (.yaw cr) (* 0.15 (Class|BPMover|GetOpenYaw :self d)))))))
          (:1 (Transformation|SetActorLocation :self (Variables|Default|GetCB) :NewLocation (Math|Vector|MakeVector :X (.x cbl) :Y (.y cbl) :Z 1.0)))
          (:2 (Transformation|SetActorLocation :self (Variables|Default|GetCB) :NewLocation (Math|Vector|MakeVector :X (.x cbl) :Y (.y cbl) :Z 2.0)))
          (:3 (Class|BPSwitch|SetOn :self (Variables|Default|GetLightCand) :On true))
          (:4 (bind caps (Actor|GetAllActorswithTag :Tag "dy_hallcap"))
               (for cp caps (Transformation|SetActorLocation :self cp :NewLocation (+ (Transformation|GetActorLocation :self cp) (Math|Vector|MakeVector :X 0.0 :Y 80.0 :Z 0.0)))))
          (:Default
            (bind show (Actor|GetAllActorswithTag :Tag (Utilities|Array|Get(acopy) :Array (Variables|Default|GetShowTags) :"Dimension 1" r)))
            (for a show (Rendering|SetActorHiddenInGame :self a :bNewHidden false))
            (bind hide (Actor|GetAllActorswithTag :Tag (Utilities|Array|Get(acopy) :Array (Variables|Default|GetHideTags) :"Dimension 1" r)))
            (for h hide (Rendering|SetActorHiddenInGame :self h :bNewHidden true) (Collision|SetActorEnableCollision :self h :bNewActorEnableCollision false))))))))
