(event EventBeginPlay
  (bind f_UB (Actor|GetAllActorswithTag :Tag "ub")) (for a_UB f_UB (Variables|Default|SetUB a_UB)) (bind f_SB (Actor|GetAllActorswithTag :Tag "sb")) (for a_SB f_SB (Variables|Default|SetSB a_SB)) (bind f_CB (Actor|GetAllActorswithTag :Tag "cb")) (for a_CB f_CB (Variables|Default|SetCB a_CB))
  (bind huds (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_HUD.BP_HUD_C"))
  (for h huds (Variables|Default|SetHudRef h))
  (Variables|Default|SetMus0 (Audio|SpawnSound2D :Sound "/Game/Audio/music_title.music_title" :VolumeMultiplier 0.01 :bAutoDestroy false))
  (Variables|Default|SetMus1 (Audio|SpawnSound2D :Sound "/Game/Audio/music_day1_calm.music_day1_calm" :VolumeMultiplier 0.01 :bAutoDestroy false))
  (Variables|Default|SetMus2 (Audio|SpawnSound2D :Sound "/Game/Audio/music_unease_low.music_unease_low" :VolumeMultiplier 0.01 :bAutoDestroy false))
  (Variables|Default|SetMus3 (Audio|SpawnSound2D :Sound "/Game/Audio/music_unease_mid.music_unease_mid" :VolumeMultiplier 0.01 :bAutoDestroy false))
  (Variables|Default|SetMus4 (Audio|SpawnSound2D :Sound "/Game/Audio/music_unease_high.music_unease_high" :VolumeMultiplier 0.01 :bAutoDestroy false))
  (Variables|Default|SetMus5 (Audio|SpawnSound2D :Sound "/Game/Audio/music_loop_sequence.music_loop_sequence" :VolumeMultiplier 0.01 :bAutoDestroy false))
  ; the menu and the in-game overlay are widgets: they have to be made and put on screen here, nothing else does it
  (bind pc0 (Game|GetPlayerController :PlayerIndex 0))
  (Variables|Default|SetMenuW (UserInterface|CreateWidget :Class "/Game/UI/WBP_Menu.WBP_Menu_C" :OwningPlayer pc0))
  (UserInterface|Viewport|AddtoViewport :self (Variables|Default|GetMenuW) :ZOrder 10)
  (Variables|Default|SetOverlayW (UserInterface|CreateWidget :Class "/Game/UI/WBP_Overlay.WBP_Overlay_C" :OwningPlayer pc0))
  (UserInterface|Viewport|AddtoViewport :self (Variables|Default|GetOverlayW) :ZOrder 5))

(event EventTick (DeltaSeconds)
  (bind hud (Variables|Default|GetHudRef))
  (bind pc (Game|GetPlayerController :PlayerIndex 0))
  (bind pawn (Game|GetPlayerPawn :PlayerIndex 0))
  (if (not (Variables|Default|GetInit))
    ; the director's own title (keyboard image menu, old camera spots) is retired: mode 9 is ours
    (Variables|Default|SetInit true)
    (Class|BPHUD|SetMode :self hud :Mode 9)
    (Class|AudioComponent|SetVolumeMultiplier :self (Class|BPHUD|GetMusic :self hud) :VolumeMultiplier 0.001))
  (bind mode (Class|BPHUD|GetMode :self hud))
  ; ---------------- the menu board: X = screen showing (0 = play), Y = the button just pressed ----------------
  (bind ubl0 (Transformation|GetActorLocation :self (Variables|Default|GetUB)))
  (Variables|Default|SetScreen (Math|Float|Round :A (.x ubl0)))
  (Variables|Default|SetCmd (Math|Float|Round :A (.y ubl0)))
  (bind screen (Variables|Default|GetScreen))
  (bind cmd (Variables|Default|GetCmd))
  (if (> cmd 0) (Transformation|SetActorLocation :self (Variables|Default|GetUB) :NewLocation (Math|Vector|MakeVector :X (.x ubl0) :Y 0.0 :Z (.z ubl0))))
  (bind sbl (Transformation|GetActorLocation :self (Variables|Default|GetSB)))
  ; any menu frees the mouse (pointer shown, not locked to the window); it is captured again only when play resumes
  (bind menuOn (select (> screen 0) 1 0))
  (if (!= menuOn (Variables|Default|GetCursorOn))
    (Class|PlayerController|SetShowMouseCursor :self pc :bShowMouseCursor (== menuOn 1))
    (if (== menuOn 1)
      (Input|SetInputModeGameAndUI :PlayerController pc :InMouseLockMode "DoNotLock" :bHideCursorDuringCapture false)
      (else (Input|SetInputModeGameOnly :PlayerController pc)))
    (Variables|Default|SetCursorOn menuOn))
  ; the director's old pause menu must never show: ours is the widget
  (Class|BPHUD|SetPaused :self hud :Paused false)
  ; ---------------- accessibility: a cap on the unease effects ----------------
  (if (> (Class|BPHUD|GetTarget :self hud) (* 100.0 (.z sbl))) (Class|BPHUD|SetTarget :self hud :Target (* 100.0 (.z sbl))))
  ; ---------------- music: six named slots, crossfaded by where the game is and how high the unease is ----------------
  (bind u (Class|BPHUD|GetUnease :self hud))
  (bind inplay (and (!= mode 9) (and (!= mode 6) (!= mode 4))))
  (bind w0 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetVol0) :Target (select (== mode 9) 1.0 0.0) :DeltaTime DeltaSeconds :InterpSpeed 0.7))
  (Variables|Default|SetVol0 w0)
  (Class|AudioComponent|SetVolumeMultiplier :self (Variables|Default|GetMus0) :VolumeMultiplier (+ 0.001 (* 0.6 w0)))
  (bind w1 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetVol1) :Target (select (and inplay (< u 15.0)) 1.0 0.0) :DeltaTime DeltaSeconds :InterpSpeed 0.7))
  (Variables|Default|SetVol1 w1)
  (Class|AudioComponent|SetVolumeMultiplier :self (Variables|Default|GetMus1) :VolumeMultiplier (+ 0.001 (* 0.6 w1)))
  (bind w2 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetVol2) :Target (select (and inplay (and (>= u 15.0) (< u 45.0))) 1.0 0.0) :DeltaTime DeltaSeconds :InterpSpeed 0.7))
  (Variables|Default|SetVol2 w2)
  (Class|AudioComponent|SetVolumeMultiplier :self (Variables|Default|GetMus2) :VolumeMultiplier (+ 0.001 (* 0.6 w2)))
  (bind w3 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetVol3) :Target (select (and inplay (and (>= u 45.0) (< u 75.0))) 1.0 0.0) :DeltaTime DeltaSeconds :InterpSpeed 0.7))
  (Variables|Default|SetVol3 w3)
  (Class|AudioComponent|SetVolumeMultiplier :self (Variables|Default|GetMus3) :VolumeMultiplier (+ 0.001 (* 0.6 w3)))
  (bind w4 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetVol4) :Target (select (and inplay (>= u 75.0)) 1.0 0.0) :DeltaTime DeltaSeconds :InterpSpeed 0.7))
  (Variables|Default|SetVol4 w4)
  (Class|AudioComponent|SetVolumeMultiplier :self (Variables|Default|GetMus4) :VolumeMultiplier (+ 0.001 (* 0.6 w4)))
  (bind w5 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetVol5) :Target (select (== mode 6) 1.0 0.0) :DeltaTime DeltaSeconds :InterpSpeed 0.7))
  (Variables|Default|SetVol5 w5)
  (Class|AudioComponent|SetVolumeMultiplier :self (Variables|Default|GetMus5) :VolumeMultiplier (+ 0.001 (* 0.6 w5)))
  ; ---------------- the title: a slow look round the house; the view moves on every ten seconds ----------------
  (if (== mode 9)
    (bind mt (+ (Variables|Default|GetMenuT) DeltaSeconds))
    (Variables|Default|SetMenuT mt)
    (bind mv (Variables|Default|GetMenuV))
    (if (> mt 9.4) (Class|BPHUD|SetFadeTarget :self hud :FadeTarget 1.0))
    (if (> mt 10.0)
      (Variables|Default|SetMenuV (select (>= mv 4) 0 (+ mv 1)))
      (Variables|Default|SetMenuT 0.0)
      (Class|BPHUD|SetFadeTarget :self hud :FadeTarget 0.0))
    (Transformation|SetActorLocation :self pawn :NewLocation (Math|Vector|MakeVector :X (+ (select (== mv 0) 50.0 (select (== mv 1) 170.0 (select (== mv 2) -300.0 (select (== mv 3) 290.0 -1380.0)))) (* 16.0 (Math|Trig|Sin(Radians) (* mt 0.21)))) :Y (select (== mv 0) 150.0 (select (== mv 1) -250.0 (select (== mv 2) -370.0 (select (== mv 3) 0.0 730.0)))) :Z (select (== mv 0) 92.0 (select (== mv 1) 92.0 (select (== mv 2) 92.0 (select (== mv 3) 351.0 -47.0))))))
    (Pawn|SetControlRotation :self pc :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch (select (== mv 0) -6.0 (select (== mv 1) -5.0 (select (== mv 2) -3.0 (select (== mv 3) -8.0 -2.0)))) :Yaw (+ (select (== mv 0) 135.0 (select (== mv 1) 49.0 (select (== mv 2) 24.0 (select (== mv 3) -57.0 33.0)))) (* 5.0 (Math|Trig|Sin(Radians) (* mt 0.17))))))
    (Class|BPHUD|SetTarget :self hud :Target 18.0))
  ; ---------------- New game: the director's Day One, starting with the drive in ----------------
  (if (and (== mode 9) (== cmd 1))
    (Class|BPHUD|SetMode :self hud :Mode 5) (Class|BPHUD|SetT :self hud :T 0.0) (Class|BPHUD|SetFade :self hud :Fade 1.0) (Class|BPHUD|SetFadeSpeed :self hud :FadeSpeed 0.5) (Class|BPHUD|SetTarget :self hud :Target 0.0) (Class|BPHUD|SetFadeTarget :self hud :FadeTarget 0.0)
    (Transformation|SetActorLocation :self (Variables|Default|GetUB) :NewLocation (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 1.0))
    (Collision|SetActorEnableCollision :self pawn :bNewActorEnableCollision false)
    (Class|BPHUD|SetEngine :self hud :Engine (Audio|SpawnSound2D :Sound "/Game/Audio/car_engine.car_engine" :VolumeMultiplier 0.55 :bAutoDestroy false)))
  (if (== cmd 3) (Class|BPHUD|SetLoopStart :self hud :LoopStart true) (Transformation|SetActorLocation :self (Variables|Default|GetUB) :NewLocation (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 1.0)))
  ; ---------------- the chore day (F5, its menu line, or the story asking for a day to begin) ----------------
  (if (or (== cmd 2) (Game|Player|WasInputKeyJustPressed :self pc :Key "F5")) (Variables|Default|SetChoreStart true))
  (if (Variables|Default|GetChoreStart)
    (Variables|Default|SetChoreStart false)
    (if (== mode 9)
      (Transformation|SetActorLocation :self pawn :NewLocation (Math|Vector|MakeVector :X -150.0 :Y -270.0 :Z 92.0))
      (Pawn|SetControlRotation :self pc :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 0.0 :Yaw 0.0))
      (Class|BPHUD|SetFade :self hud :Fade 1.0) (Class|BPHUD|SetFadeSpeed :self hud :FadeSpeed 0.6) (Class|BPHUD|SetFadeTarget :self hud :FadeTarget 0.0))
    (Class|BPHUD|SetMode :self hud :Mode 8) (Class|BPHUD|SetPower :self hud :Power true) (Class|BPHUD|SetTarget :self hud :Target 10.0)
    (Collision|SetActorEnableCollision :self pawn :bNewActorEnableCollision true)
    (Input|ResetIgnoreMoveInput :self pc)
    (Input|ResetIgnoreLookInput :self pc)
    (bind gp8 (Actor|GetAllActorswithTag :Tag "periph"))
    (for hp8 gp8 (Actor|Tick|SetActorTickEnabled :self hp8 :bEnabled false))
    (bind cbl8 (Transformation|GetActorLocation :self (Variables|Default|GetCB)))
    (Transformation|SetActorLocation :self (Variables|Default|GetCB) :NewLocation (Math|Vector|MakeVector :X (.x cbl8) :Y 1.0 :Z (.z cbl8)))
    (Transformation|SetActorLocation :self (Variables|Default|GetUB) :NewLocation (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 1.0)))
  (if (== cmd 5) (Game|OpenLevel(byName) :LevelName "POC_VisualSlice"))
  (if (== cmd 6) (Game|QuitGame))
  ; ---------------- pause (Esc): the game keeps running underneath, Jack stands still, the mouse is released ----------------
  (bind esc (Game|Player|WasInputKeyJustPressed :self pc :Key "Escape"))
  (bind playing (or (or (== mode 1) (== mode 3)) (or (== mode 6) (== mode 8))))
  (if (and esc (> screen 2))
    (Transformation|SetActorLocation :self (Variables|Default|GetUB) :NewLocation (Math|Vector|MakeVector :X (.z ubl0) :Y 0.0 :Z (.z ubl0))))
  (if (and (and esc (== screen 0)) playing)
    (Input|SetIgnoreMoveInput :self pc :bNewMoveInput true)
    (Input|SetIgnoreLookInput :self pc :bNewLookInput true)
    (Transformation|SetActorLocation :self (Variables|Default|GetUB) :NewLocation (Math|Vector|MakeVector :X 2.0 :Y 0.0 :Z 2.0)))
  (if (and (== screen 2) (or esc (== cmd 4)))
    (Input|ResetIgnoreMoveInput :self pc)
    (Input|ResetIgnoreLookInput :self pc)
    (Transformation|SetActorLocation :self (Variables|Default|GetUB) :NewLocation (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 2.0))))
