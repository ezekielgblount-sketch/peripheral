(event EventBeginPlay
  (bind f_BoxA (Actor|GetAllActorswithTag :Tag "s_boxa"))
  (for a_BoxA f_BoxA (Variables|Default|SetBoxA a_BoxA))
  (bind f_BoxB (Actor|GetAllActorswithTag :Tag "s_boxb"))
  (for a_BoxB f_BoxB (Variables|Default|SetBoxB a_BoxB))
  (bind f_Mail (Actor|GetAllActorswithTag :Tag "s_mail"))
  (for a_Mail f_Mail (Variables|Default|SetMail a_Mail))
  (bind f_Door (Actor|GetAllActorswithTag :Tag "s_door"))
  (for a_Door f_Door (Variables|Default|SetDoor a_Door))
  (bind f_Lever (Actor|GetAllActorswithTag :Tag "s_lever"))
  (for a_Lever f_Lever (Variables|Default|SetLever a_Lever))
  (bind f_Sash (Actor|GetAllActorswithTag :Tag "s_sash"))
  (for a_Sash f_Sash (Variables|Default|SetSash a_Sash))
  (bind f_PDoor (Actor|GetAllActorswithTag :Tag "s_pdoor"))
  (for a_PDoor f_PDoor (Variables|Default|SetPDoor a_PDoor))
  (bind f_BB (Actor|GetAllActorswithTag :Tag "bb"))
  (for a_BB f_BB (Variables|Default|SetBB a_BB))
  (bind f_Car (Actor|GetAllActorswithTag :Tag "s_car"))
  (for a_Car f_Car (Variables|Default|SetCar a_Car))
  (bind f_Hint (Actor|GetAllActorswithTag :Tag "s_hint"))
  (for a_Hint f_Hint (Variables|Default|SetHint a_Hint))
  (Variables|Default|SetBoxA0 (Transformation|GetActorLocation :self (Variables|Default|GetBoxA)))
  (Variables|Default|SetLever0 (Transformation|GetActorLocation :self (Variables|Default|GetLever)))
  (Variables|Default|SetSash0 (Transformation|GetActorLocation :self (Variables|Default|GetSash)))
  (Variables|Default|SetDoorYaw0 (.yaw (Transformation|GetActorRotation :self (Variables|Default|GetDoor))))
  (Variables|Default|SetPDoorYaw0 (.yaw (Transformation|GetActorRotation :self (Variables|Default|GetPDoor))))
  (Variables|Default|SetMusic (Audio|SpawnSound2D :Sound "/Game/Audio/music_dayone.music_dayone" :VolumeMultiplier 0.5 :bAutoDestroy false))
  (Variables|Default|SetHiss (Audio|SpawnSound2D :Sound "/Game/Audio/tape_hiss.tape_hiss" :VolumeMultiplier 0.3 :bAutoDestroy false))
  (Variables|Default|SetMuffle (Audio|SpawnSound2D :Sound "/Game/Audio/underwater.underwater" :VolumeMultiplier 0.8 :bAutoDestroy false))
  (Audio|PlaySound2D :Sound "/Game/Audio/room_tone.room_tone" :VolumeMultiplier 0.5)
  (Variables|Default|SetTask 1)
  (Variables|Default|SetFade 1.0)
  (Variables|Default|SetFadeTarget 0.0)
  (Variables|Default|SetTarget 18.0)
  (Variables|Default|SetQuality 3)
  (Variables|Default|SetPreset 1)
  (bind pc0 (HUD|GetOwningPlayerController))
  (Input|SetIgnoreMoveInput :self pc0 :bNewMoveInput true)
  (Input|SetIgnoreLookInput :self pc0 :bNewLookInput true)
  (Variables|Default|SetFadeSpeed 2.5)
  (Variables|Default|SetSensLv 3)
  (bind bb0 (Variables|Default|GetBB))
  (Transformation|SetActorLocation :self bb0 :NewLocation (Math|Vector|MakeVector :X (.x (Transformation|GetActorLocation :self bb0)) :Y 0.6 :Z 0.0))
  (bind f_LB (Actor|GetAllActorswithTag :Tag "lb"))
  (for a_LB f_LB (Variables|Default|SetLB a_LB)))

(event EventTick (DeltaSeconds)
  (bind pc (HUD|GetOwningPlayerController))
  (bind pawn (Game|GetPlayerPawn :PlayerIndex 0))
  (bind ploc (Transformation|GetActorLocation :self pawn))
  (bind mode (Variables|Default|GetMode))
  (bind task (Variables|Default|GetTask))
  (bind step (Variables|Default|GetStep))
  (bind bb (Variables|Default|GetBB))
  ; menus use the real mouse pointer; the pointer is hidden and the mouse turns the head only while playing
  (bind menuOn (select (or (or (== mode 0) (== mode 2)) (or (== mode 7) (or (== mode 4) (Variables|Default|GetPaused)))) 1 0))
  (if (!= menuOn (Variables|Default|GetCursorOn))
    (Class|PlayerController|SetShowMouseCursor :self pc :bShowMouseCursor (== menuOn 1))
    (if (== menuOn 1)
      (Input|SetInputModeGameAndUI :PlayerController pc :bHideCursorDuringCapture false)
      (else (Input|SetInputModeGameOnly :PlayerController pc)))
    (Variables|Default|SetCursorOn menuOn))
  ; ---------------- unease dial: number keys jump to a stage, F1 opens the debug bar, arrows nudge it ----------------
  (if (or (== mode 1) (== mode 3))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "One") (Variables|Default|SetTarget 10.0))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Two") (Variables|Default|SetTarget 20.0))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Three") (Variables|Default|SetTarget 30.0))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Four") (Variables|Default|SetTarget 40.0))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Five") (Variables|Default|SetTarget 50.0))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Six") (Variables|Default|SetTarget 60.0))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Seven") (Variables|Default|SetTarget 70.0))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Eight") (Variables|Default|SetTarget 80.0))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Nine") (Variables|Default|SetTarget 90.0))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Zero") (Variables|Default|SetTarget 100.0))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Hyphen") (Variables|Default|SetTarget 0.0)))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "F1") (Variables|Default|SetDebug (not (Variables|Default|GetDebug))))
  (if (Variables|Default|GetDebug)
    (if (Game|Player|IsInputKeyDown :self pc :Key "Right") (Variables|Default|SetTarget (Math|Float|Min(Float) :A 100.0 :B (+ (Variables|Default|GetTarget) (* DeltaSeconds 40.0)))))
    (if (Game|Player|IsInputKeyDown :self pc :Key "Left") (Variables|Default|SetTarget (Math|Float|Max(Float) :A 0.0 :B (- (Variables|Default|GetTarget) (* DeltaSeconds 40.0))))))
  (if (Variables|Default|GetDebug)
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Up") (Variables|Default|SetPreset (Math|Integer|Min(Integer) :A 2 :B (+ (Variables|Default|GetPreset) 1))))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Down") (Variables|Default|SetPreset (Math|Integer|Max(Integer) :A 0 :B (- (Variables|Default|GetPreset) 1)))))
  (Rendering|Material|SetScalarParameterValue :Collection "/Game/Materials/MPC_World.MPC_World" :ParameterName "Preset" :ParameterValue (Math|Conversions|ToFloat(Integer) (Variables|Default|GetPreset)))
  (bind u (Math|Interpolation|FInterptoConstant :Current (Variables|Default|GetUnease) :Target (Variables|Default|GetTarget) :DeltaTime DeltaSeconds :InterpSpeed 9.0))
  (Variables|Default|SetUnease u)
  (Rendering|Material|SetScalarParameterValue :Collection "/Game/Materials/MPC_World.MPC_World" :ParameterName "Unease" :ParameterValue (/ u 100.0))
  (bind tsec (Utilities|Time|GetGameTimeinSeconds))
  (bind s3 (Math|Float|Clamp(Float) :Value (/ (- u 55.0) 20.0) :Min 0.0 :Max 1.0))
  (bind s4 (Math|Float|Clamp(Float) :Value (/ (- u 85.0) 15.0) :Min 0.0 :Max 1.0))
  ; sound follows the dial: tape hiss from stage 2, music warbles and slows from stage 3, a muffled underwater bed at stage 4
  (Audio|Components|Audio|SetPaused :self (Variables|Default|GetHiss) :bPause (< u 38.0))
  (Audio|Components|Audio|SetPitchMultiplier :self (Variables|Default|GetHiss) :NewPitchMultiplier (- 1.0 (* 0.35 s4)))
  (Audio|Components|Audio|SetPitchMultiplier :self (Variables|Default|GetMusic) :NewPitchMultiplier (- (- 1.0 (* (* 0.08 s3) (Math|Trig|Sin(Radians) (* tsec 0.9)))) (* 0.3 s4)))
  (Audio|Components|Audio|SetPaused :self (Variables|Default|GetMuffle) :bPause (< u 86.0))
  ; ---------------- fade ----------------
  (Variables|Default|SetFade (Math|Interpolation|FInterptoConstant :Current (Variables|Default|GetFade) :Target (Variables|Default|GetFadeTarget) :DeltaTime DeltaSeconds :InterpSpeed (Variables|Default|GetFadeSpeed)))
  (Variables|Default|SetNoteT (- (Variables|Default|GetNoteT) DeltaSeconds))
  ; ---------------- day / night (N) ----------------
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "N")
    (bind night (not (Variables|Default|GetNight)))
    (Variables|Default|SetNight night)
    (Rendering|Material|SetScalarParameterValue :Collection "/Game/Materials/MPC_World.MPC_World" :ParameterName "Night" :ParameterValue (select night 1.0 0.0))
    (bind dl (Actor|GetAllActorswithTag :Tag "day_light"))
    (for b dl (Rendering|SetActorHiddenInGame :self b :bNewHidden night)))
  ; ---------------- title screen: a slow live look around the house behind the menu; the view moves on every ten seconds ----------------
  (if (or (== mode 0) (or (== mode 2) (== mode 7)))
    (bind mt (+ (Variables|Default|GetMenuT) DeltaSeconds))
    (Variables|Default|SetMenuT mt)
    (bind mv (Variables|Default|GetMenuV))
    (if (> mt 9.4) (Variables|Default|SetFadeTarget 1.0))
    (if (> mt 10.0)
      (Variables|Default|SetMenuV (select (>= mv 4) 0 (+ mv 1)))
      (Variables|Default|SetMenuT 0.0)
      (Variables|Default|SetFadeTarget 0.0))
    (Transformation|SetActorLocation :self pawn :NewLocation (Math|Vector|MakeVector
      :X (+ (select (== mv 0) 50.0 (select (== mv 1) 250.0 (select (== mv 2) -250.0 (select (== mv 3) 200.0 -1380.0)))) (* 16.0 (Math|Trig|Sin(Radians) (* mt 0.21))))
      :Y (select (== mv 0) 165.0 (select (== mv 1) -140.0 (select (== mv 2) -290.0 (select (== mv 3) -265.0 590.0))))
      :Z (select (== mv 0) 92.0 (select (== mv 1) 92.0 (select (== mv 2) 92.0 (select (== mv 3) 351.0 -47.0))))))
    (Pawn|SetControlRotation :self pc :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch (select (== mv 0) -6.0 (select (== mv 1) -5.0 (select (== mv 2) -3.0 (select (== mv 3) -8.0 -2.0))))
      :Yaw (+ (select (== mv 0) 138.0 (select (== mv 1) 74.0 (select (== mv 2) 7.0 (select (== mv 3) -50.0 34.0)))) (* 5.0 (Math|Trig|Sin(Radians) (* mt 0.17))))))
    ; the real mouse pointer (no lag): hovering picks a line, clicking chooses it
    (bind (mx my mok) (Game|Player|GetMousePosition :self pc))
    (if mok (Variables|Default|SetCurX mx) (Variables|Default|SetCurY my)))
  ; jump to the loop (L, the menu, or the end of the montage). Kept ahead of the Day One and montage blocks: nothing after their
  ; switch statements runs while those modes are active.
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "L") (Variables|Default|SetLoopStart true))
  (if (Variables|Default|GetLoopStart)
    (Variables|Default|SetLoopStart false)
    (Variables|Default|SetMode 6)
    (Variables|Default|SetFade 1.0) (Variables|Default|SetFadeSpeed 0.6) (Variables|Default|SetFadeTarget 0.0)
    (Variables|Default|SetPower true) (Variables|Default|SetTarget 70.0) (Variables|Default|SetPaused false)
    (Collision|SetActorEnableCollision :self pawn :bNewActorEnableCollision true)
    (Input|ResetIgnoreMoveInput :self pc)
    (Input|ResetIgnoreLookInput :self pc)
    (bind gp (Actor|GetAllActorswithTag :Tag "periph"))
    (for hp gp (Actor|Tick|SetActorTickEnabled :self hp :bEnabled false))
    (Variables|Default|SetNight true)
    (Rendering|Material|SetScalarParameterValue :Collection "/Game/Materials/MPC_World.MPC_World" :ParameterName "Night" :ParameterValue 1.0)
    (bind dl2 (Actor|GetAllActorswithTag :Tag "day_light"))
    (for b2 dl2 (Rendering|SetActorHiddenInGame :self b2 :bNewHidden true))
    ; he starts at the front end of the upstairs hall, looking down it; from here on he is never moved
    (Transformation|SetActorLocation :self pawn :NewLocation (Math|Vector|MakeVector :X -410.0 :Y -150.0 :Z 351.0))
    (Pawn|SetControlRotation :self pc :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 0.0 :Yaw 0.0))
    (Transformation|SetActorLocation :self (Variables|Default|GetLB) :NewLocation (Math|Vector|MakeVector :X 1.0 :Y 0.0 :Z 0.0)))
  ; ---------------- title menu: up / down, Enter (letter keys still work as shortcuts) ----------------
  (if (== mode 0)
    (bind mi0 (Variables|Default|GetMenuIdx))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Down") (Variables|Default|SetMenuIdx (Math|Integer|Min(Integer) :A 4 :B (+ mi0 1))) (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.35))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Up") (Variables|Default|SetMenuIdx (Math|Integer|Max(Integer) :A 0 :B (- mi0 1))) (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.35))
    (bind cy (Variables|Default|GetCurY))
    (bind moved (> (Math|Float|Absolute(Float) (- cy (Variables|Default|GetPrevCY))) 0.5))
    (bind sh2 (Variables|Default|GetScrH))
    (bind over (and (< (Variables|Default|GetCurX) (+ (* (Variables|Default|GetScrW) 0.06) (* sh2 0.62))) (and (> cy (* sh2 0.468)) (< cy (* sh2 0.758)))))
    (if (and moved (and (> cy (* sh2 0.468)) (< cy (* sh2 0.526)))) (Variables|Default|SetMenuIdx 0))
    (if (and moved (and (> cy (* sh2 0.526)) (< cy (* sh2 0.584)))) (Variables|Default|SetMenuIdx 1))
    (if (and moved (and (> cy (* sh2 0.584)) (< cy (* sh2 0.642)))) (Variables|Default|SetMenuIdx 2))
    (if (and moved (and (> cy (* sh2 0.642)) (< cy (* sh2 0.700)))) (Variables|Default|SetMenuIdx 3))
    (if (and moved (and (> cy (* sh2 0.700)) (< cy (* sh2 0.758)))) (Variables|Default|SetMenuIdx 4))
    (Variables|Default|SetPrevCY cy)
    (bind go (or (Game|Player|WasInputKeyJustPressed :self pc :Key "Enter") (and over (Game|Player|WasInputKeyJustPressed :self pc :Key "LeftMouseButton"))))
    (if (and go (== mi0 0))
      (Variables|Default|SetMode 5)
      (Variables|Default|SetT 0.0)
      (Variables|Default|SetFade 1.0)
      (Variables|Default|SetFadeSpeed 0.5)
      (Variables|Default|SetTarget 0.0)
      (Variables|Default|SetFadeTarget 0.0)
      (Collision|SetActorEnableCollision :self pawn :bNewActorEnableCollision false)
      (Variables|Default|SetEngine (Audio|SpawnSound2D :Sound "/Game/Audio/car_engine.car_engine" :VolumeMultiplier 0.55 :bAutoDestroy false)))
    (if (and go (== mi0 1)) (Variables|Default|SetLoopStart true))
    (if (or (and go (== mi0 2)) (Game|Player|WasInputKeyJustPressed :self pc :Key "S")) (Variables|Default|SetMode 2))
    (if (and go (== mi0 3)) (Variables|Default|SetMode 7))
    (if (or (and go (== mi0 4)) (Game|Player|WasInputKeyJustPressed :self pc :Key "Q")) (Game|QuitGame)))
  (if (== mode 7)
    (if (or (Game|Player|WasInputKeyJustPressed :self pc :Key "Enter") (Game|Player|WasInputKeyJustPressed :self pc :Key "Escape")) (Variables|Default|SetMode 0)))
  ; ---------------- pause menu (Esc): the game keeps running underneath, but Jack stands still ----------------
  (bind paused (Variables|Default|GetPaused))
  (if (and (Game|Player|WasInputKeyJustPressed :self pc :Key "Escape") (or (== mode 1) (or (== mode 3) (== mode 6))))
    (Input|SetIgnoreMoveInput :self pc :bNewMoveInput (not paused))
    (Input|SetIgnoreLookInput :self pc :bNewLookInput (not paused))
    (Variables|Default|SetPauseIdx 0)
    (Variables|Default|SetPaused (not paused)))
  (if paused
    (bind pi0 (Variables|Default|GetPauseIdx))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Down") (Variables|Default|SetPauseIdx (Math|Integer|Min(Integer) :A 2 :B (+ pi0 1))))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Up") (Variables|Default|SetPauseIdx (Math|Integer|Max(Integer) :A 0 :B (- pi0 1))))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Enter")
      (if (== pi0 0)
        (Variables|Default|SetPaused false)
        (Input|SetIgnoreMoveInput :self pc :bNewMoveInput false)
        (Input|SetIgnoreLookInput :self pc :bNewLookInput false))
      (if (== pi0 1) (Game|OpenLevel(byName) :LevelName "POC_VisualSlice"))
      (if (== pi0 2) (Game|QuitGame))))
  ; ---------------- settings: up / down picks a row, left / right changes it. The blackboard holds X = camera motion, Y = mouse speed ----------------
  (if (== mode 2)
    (bind row (Variables|Default|GetSetRow))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Down") (Variables|Default|SetSetRow (Math|Integer|Min(Integer) :A 2 :B (+ row 1))))
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Up") (Variables|Default|SetSetRow (Math|Integer|Max(Integer) :A 0 :B (- row 1))))
    (bind left (Game|Player|WasInputKeyJustPressed :self pc :Key "Left"))
    (bind right (Game|Player|WasInputKeyJustPressed :self pc :Key "Right"))
    (bind mi (.x (Transformation|GetActorLocation :self bb)))
    (if (and (== row 0) (or left right))
      (Transformation|SetActorLocation :self bb :NewLocation (Math|Vector|MakeVector :X (select (> mi 0.75) 0.5 (select (> mi 0.25) 0.0 1.0)) :Y (.y (Transformation|GetActorLocation :self bb)) :Z (.z (Transformation|GetActorLocation :self bb)))))
    (if (and (== row 1) right)
      (Variables|Default|SetQuality (Math|Integer|Min(Integer) :A 3 :B (+ (Variables|Default|GetQuality) 1)))
      (Development|ExecuteConsoleCommand :Command (select (== (Variables|Default|GetQuality) 3) "Scalability 3" (select (== (Variables|Default|GetQuality) 2) "Scalability 2" "Scalability 1"))))
    (if (and (== row 1) left)
      (Variables|Default|SetQuality (Math|Integer|Max(Integer) :A 0 :B (- (Variables|Default|GetQuality) 1)))
      (Development|ExecuteConsoleCommand :Command (select (== (Variables|Default|GetQuality) 2) "Scalability 2" (select (== (Variables|Default|GetQuality) 1) "Scalability 1" "Scalability 0"))))
    (if (and (== row 2) right) (Variables|Default|SetSensLv (Math|Integer|Min(Integer) :A 5 :B (+ (Variables|Default|GetSensLv) 1))))
    (if (and (== row 2) left) (Variables|Default|SetSensLv (Math|Integer|Max(Integer) :A 1 :B (- (Variables|Default|GetSensLv) 1))))
    (if (== row 2)
      (Transformation|SetActorLocation :self bb :NewLocation (Math|Vector|MakeVector :X (.x (Transformation|GetActorLocation :self bb)) :Y (select (== (Variables|Default|GetSensLv) 1) 0.25 (select (== (Variables|Default|GetSensLv) 2) 0.4 (select (== (Variables|Default|GetSensLv) 3) 0.6 (select (== (Variables|Default|GetSensLv) 4) 0.9 1.3)))) :Z (.z (Transformation|GetActorLocation :self bb)))))
    (if (or (Game|Player|WasInputKeyJustPressed :self pc :Key "Escape") (Game|Player|WasInputKeyJustPressed :self pc :Key "Enter")) (Variables|Default|SetMode 0)))
  ; ---------------- power coming on, room by room ----------------
  (if (Variables|Default|GetPower)
    (bind pt (+ (Variables|Default|GetPowerT) DeltaSeconds))
    (Variables|Default|SetPowerT pt)
    (bind bl (Transformation|GetActorLocation :self bb))
    (Transformation|SetActorLocation :self bb :NewLocation (Math|Vector|MakeVector :X (.x bl) :Y (.y bl) :Z (select (> pt 3.3) 4.0 (select (> pt 2.3) 3.0 (select (> pt 1.3) 2.0 (select (> pt 0.3) 1.0 0.0)))))))
  ; ---------------- the drive in: seen from the driver's seat, down the street and into the driveway ----------------
  (if (== mode 5)
    (bind td (+ (Variables|Default|GetT) DeltaSeconds))
    (Variables|Default|SetT td)
    (bind f1 (Math|Float|Clamp(Float) :Value (/ td 9.0) :Min 0.0 :Max 1.0))
    (bind f2 (Math|Float|Clamp(Float) :Value (/ (- td 9.0) 2.5) :Min 0.0 :Max 1.0))
    (bind f3r (Math|Float|Clamp(Float) :Value (/ (- td 11.5) 3.5) :Min 0.0 :Max 1.0))
    (bind f3 (- 1.0 (* (- 1.0 f3r) (- 1.0 f3r))))
    (bind cx (+ (+ -2100.0 (* 400.0 f2)) (* 730.0 f3)))
    (bind cy (+ (+ -1850.0 (* 2440.0 f1)) (* 200.0 f2)))
    (bind cz (+ -152.0 (* 14.0 f3)))
    (bind yaw (- 90.0 (* 90.0 f2)))
    (bind cs (Math|Trig|Cos(Degrees) yaw))
    (bind sn (Math|Trig|Sin(Degrees) yaw))
    (Transformation|SetActorLocationAndRotation :self (Variables|Default|GetCar) :NewLocation (Math|Vector|MakeVector :X cx :Y cy :Z cz) :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 0.0 :Yaw yaw))
    (Transformation|SetActorLocationAndRotation :self (Variables|Default|GetBoxA) :NewLocation (Math|Vector|MakeVector :X (+ cx (- (* -182.0 cs) (* 32.0 sn))) :Y (+ cy (+ (* -182.0 sn) (* 32.0 cs))) :Z (+ cz 58.6)) :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 0.0 :Yaw (+ yaw 180.0)))
    (Transformation|SetActorLocationAndRotation :self (Variables|Default|GetBoxB) :NewLocation (Math|Vector|MakeVector :X (+ cx (- (* -182.0 cs) (* -34.0 sn))) :Y (+ cy (+ (* -182.0 sn) (* -34.0 cs))) :Z (+ cz 58.6)) :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 0.0 :Yaw (+ yaw 174.0)))
    (Transformation|SetActorLocation :self pawn :NewLocation (Math|Vector|MakeVector :X (+ cx (- (* 8.0 cs) (* -36.0 sn))) :Y (+ cy (+ (* 8.0 sn) (* -36.0 cs))) :Z (+ cz 36.0)))
    (Pawn|SetControlRotation :self pc :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch -4.0 :Yaw yaw))
    (if (> td 15.5) (Variables|Default|SetFadeTarget 1.0))
    (if (> td 17.6)
      (Variables|Default|SetBoxA0 (Transformation|GetActorLocation :self (Variables|Default|GetBoxA)))
      (Transformation|SetActorLocation :self pawn :NewLocation (Math|Vector|MakeVector :X -990.0 :Y 655.0 :Z -46.0))
      (Pawn|SetControlRotation :self pc :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 0.0 :Yaw 160.0))
      (Collision|SetActorEnableCollision :self pawn :bNewActorEnableCollision true)
      (Input|SetIgnoreMoveInput :self pc :bNewMoveInput false)
      (Input|SetIgnoreLookInput :self pc :bNewLookInput false)
      (Audio|Components|Audio|Stop :self (Variables|Default|GetEngine))
      (Audio|PlaySound2D :Sound "/Game/Audio/car_door.car_door")
      (Variables|Default|SetFadeTarget 0.0)
      (Variables|Default|SetMode 1)))
  ; ---------------- objective hint: a faint warm glow on the thing the note is about (no floating markers) ----------------
  (if (== mode 1)
    (bind hintLoc (select (<= task 1) (Transformation|GetActorLocation :self (Variables|Default|GetBoxA)) (select (== task 2) (Math|Vector|MakeVector :X -490.0 :Y 14.0 :Z -60.0) (select (== task 3) (Transformation|GetActorLocation :self (Variables|Default|GetDoor)) (select (== task 4) (Transformation|GetActorLocation :self (Variables|Default|GetBoxB))
                  (select (== task 5) (Transformation|GetActorLocation :self (Variables|Default|GetMail)) (select (== task 6) (Transformation|GetActorLocation :self (Variables|Default|GetLever)) (select (== task 7) (Transformation|GetActorLocation :self (Variables|Default|GetSash)) (select (== task 8) (Math|Vector|MakeVector :X 377.0 :Y 505.0 :Z 95.0)
                  (select (== task 9) (Math|Vector|MakeVector :X 290.0 :Y -330.0 :Z 330.0) (Math|Vector|MakeVector :X 286.0 :Y -450.0 :Z 330.0)))))))))))
    (Transformation|SetActorLocation :self (Variables|Default|GetHint) :NewLocation (+ hintLoc (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 22.0))))
  (Rendering|SetActorHiddenInGame :self (Variables|Default|GetHint) :bNewHidden (or (!= mode 1) (> u 55.0)))
  ; ---------------- Day One tasks ----------------
  (if (== mode 1)
    (switch int (- task 1)
      (:0 (if (> (Math|Vector|VectorLength :A (- (Transformation|GetActorLocation :self (Variables|Default|GetBoxA)) (Variables|Default|GetBoxA0))) 50.0) (Variables|Default|SetTask 2)))
      (:1 (if (< (Math|Vector|VectorLength :A (- (Transformation|GetActorLocation :self (Variables|Default|GetBoxA)) (Math|Vector|MakeVector :X -490.0 :Y 14.0 :Z -100.0))) 260.0) (Variables|Default|SetTask 3)))
      (:2 (if (> (Math|Float|Absolute(Float) (- (.yaw (Transformation|GetActorRotation :self (Variables|Default|GetDoor))) (Variables|Default|GetDoorYaw0))) 20.0) (Variables|Default|SetTask 4)))
      (:3 (if (and (> (.x (Transformation|GetActorLocation :self (Variables|Default|GetBoxA))) -445.0) (> (.x (Transformation|GetActorLocation :self (Variables|Default|GetBoxB))) -445.0)) (Variables|Default|SetTask 5)))
      (:4 (if (< (Math|Vector|VectorLength :A (- (Transformation|GetActorLocation :self (Variables|Default|GetMail)) (Math|Vector|MakeVector :X 410.0 :Y 390.0 :Z 91.0))) 180.0) (Variables|Default|SetTask 6)))
      (:5 (if (> (Math|Vector|VectorLength :A (- (Transformation|GetActorLocation :self (Variables|Default|GetLever)) (Variables|Default|GetLever0))) 2.0)
            (Variables|Default|SetTask 7)
            (Variables|Default|SetPower true)
            (Audio|PlaySound2D :Sound "/Game/Audio/breaker_clunk.breaker_clunk")
            (Audio|PlaySound2D :Sound "/Game/Audio/lights_hum.lights_hum" :VolumeMultiplier 0.7)))
      (:6 (if (> (Math|Vector|VectorLength :A (- (Transformation|GetActorLocation :self (Variables|Default|GetSash)) (Variables|Default|GetSash0))) 15.0) (Variables|Default|SetTask 8)))
      (:7 (if (== (Utilities|Array|Length :TargetArray (Actor|GetAllActorswithTag :Tag "trash")) 0) (Variables|Default|SetTask 9)))
      (:8 (if (and (> (Math|Float|Absolute(Float) (- (.yaw (Transformation|GetActorRotation :self (Variables|Default|GetPDoor))) (Variables|Default|GetPDoorYaw0))) 20.0) (< (Math|Vector|VectorLength :A (- ploc (Math|Vector|MakeVector :X -255.0 :Y -221.0 :Z 348.0))) 150.0))
            (Variables|Default|SetNoteT 3.0))
          (if (< (Math|Vector|VectorLength :A (- ploc (Math|Vector|MakeVector :X 290.0 :Y -330.0 :Z 348.0))) 130.0)
            (Variables|Default|SetTask 10)
            (Variables|Default|SetTarget 25.0)))
      (:9 (if (and (< (Math|Vector|VectorLength :A (- ploc (Math|Vector|MakeVector :X 286.0 :Y -450.0 :Z 348.0))) 190.0) (Game|Player|WasInputKeyJustPressed :self pc :Key "E"))
            (Variables|Default|SetMode 3)
            (Variables|Default|SetStep 0)
            (Variables|Default|SetT 0.0)
            (Input|SetIgnoreMoveInput :self pc :bNewMoveInput true)
            (Transformation|SetActorLocation :self pawn :NewLocation (Math|Vector|MakeVector :X 286.0 :Y -440.0 :Z 418.0))
            (Pawn|SetControlRotation :self pc :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 55.0 :Yaw 0.0))))))
  ; ---------------- lying down, title card, then the time-skip montage ----------------
  (if (== mode 3)
    (bind t (+ (Variables|Default|GetT) DeltaSeconds))
    (Variables|Default|SetT t)
    (switch int step
      (:0 (if (> t 7.0) (Variables|Default|SetFadeTarget 1.0))
          (if (> t 10.0) (Variables|Default|SetStep 1) (Variables|Default|SetT 0.0)))
      (:1 (if (> t 5.0)
            (Variables|Default|SetStep 2) (Variables|Default|SetT 0.0) (Variables|Default|SetTarget 50.0) (Variables|Default|SetFadeTarget 0.0)
            (Input|SetIgnoreMoveInput :self pc :bNewMoveInput false)
            (Transformation|SetActorLocation :self pawn :NewLocation (Math|Vector|MakeVector :X -20.0 :Y 290.0 :Z 92.0))))
      (:2 (if (> t 42.0) (Variables|Default|SetFadeTarget 1.0))
          (if (> t 45.0)
            (Variables|Default|SetStep 3) (Variables|Default|SetT 0.0) (Variables|Default|SetTarget 75.0) (Variables|Default|SetFadeTarget 0.0)
            (Transformation|SetActorLocation :self pawn :NewLocation (Math|Vector|MakeVector :X 266.0 :Y 150.0 :Z 92.0))))
      (:3 (if (> t 42.0) (Variables|Default|SetFadeTarget 1.0))
          (if (> t 45.0)
            (Variables|Default|SetStep 4) (Variables|Default|SetT 0.0) (Variables|Default|SetTarget 100.0) (Variables|Default|SetFadeTarget 0.0)
            (Transformation|SetActorLocation :self pawn :NewLocation (Math|Vector|MakeVector :X 310.0 :Y -300.0 :Z 351.0))))
      (:4 (if (> t 42.0) (Variables|Default|SetFadeTarget 1.0))
          (if (> t 45.5) (Variables|Default|SetLoopStart true)))))
  ; ---------------- the loop: BP_Loop runs it (nobody is moved); the director only waits for it to say it is over ----------------
  (if (== mode 6)
    (if (> (.z (Transformation|GetActorLocation :self (Variables|Default|GetLB))) 0.5)
      (Variables|Default|SetMode 4) (Variables|Default|SetFadeSpeed 0.5) (Variables|Default|SetTarget 0.0)
      (Input|SetIgnoreMoveInput :self pc :bNewMoveInput true)))
  (if (== mode 4)
    (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Enter") (Game|OpenLevel(byName) :LevelName "POC_VisualSlice"))))

(event EventReceiveDrawHUD (SizeX SizeY)
  (bind w (Math|Conversions|ToFloat(Integer) SizeX))
  (bind h (Math|Conversions|ToFloat(Integer) SizeY))
  (bind mode (Variables|Default|GetMode))
  (bind fade (Variables|Default|GetFade))
  (if (and (== mode 1) (< fade 0.5))
    (HUD|DrawTexture :Texture (Utilities|Array|Get(acopy) :Array (Variables|Default|GetNotes) :"Dimension 1" (- (Variables|Default|GetTask) 1))
                     :ScreenX 28.0 :ScreenY (- h (* h 0.15)) :ScreenW (* h 0.4) :ScreenH (* h 0.125) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent")
    (if (> (Variables|Default|GetNoteT) 0.0)
      (HUD|DrawTexture :Texture "/Game/Prints/ui_notyet.ui_notyet" :ScreenX (- (* w 0.5) (* h 0.2)) :ScreenY (* h 0.72) :ScreenW (* h 0.4) :ScreenH (* h 0.1)
                       :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent")))
  (if (> fade 0.01)
    (HUD|DrawRect :RectColor (Utilities|Struct|MakeLinearColor :R 0.0 :G 0.0 :B 0.0 :A fade) :ScreenX 0.0 :ScreenY 0.0 :ScreenW w :ScreenH h))
  (Variables|Default|SetScrW w)
  (Variables|Default|SetScrH h)
  (if (or (== mode 2) (== mode 7))
    (HUD|DrawRect :RectColor (Utilities|Struct|MakeLinearColor :R 0.0 :G 0.0 :B 0.0 :A 0.78) :ScreenX 0.0 :ScreenY 0.0 :ScreenW w :ScreenH h))
  (if (== mode 0)
    (HUD|DrawTexture :Texture "/Game/Prints/ui_grad.ui_grad" :ScreenX 0.0 :ScreenY 0.0 :ScreenW (* w 0.62) :ScreenH h :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent")
    (HUD|DrawTexture :Texture "/Game/Prints/ui_logo.ui_logo" :ScreenX (* w 0.06) :ScreenY (* h 0.17) :ScreenW (* h 1.02) :ScreenH (* h 0.16) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent")
    (bind mi1 (Variables|Default|GetMenuIdx))
    (HUD|DrawTexture :Texture (Utilities|Array|Get(acopy) :Array (Variables|Default|GetUI) :"Dimension 1" mi1) :ScreenX (* w 0.06) :ScreenY (* h 0.46) :ScreenW (* h 0.9) :ScreenH (* h 0.36) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent"))
  (if (== mode 7)
    (HUD|DrawTexture :Texture (Utilities|Array|Get(acopy) :Array (Variables|Default|GetUI) :"Dimension 1" 8) :ScreenX (* w 0.1) :ScreenY (- (* h 0.5) (* w 0.16)) :ScreenW (* w 0.8) :ScreenH (* w 0.32) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent"))
  (if (== mode 2)
    (bind mi (.x (Transformation|GetActorLocation :self (Variables|Default|GetBB))))
    (bind q (Variables|Default|GetQuality))
    (bind srow (Variables|Default|GetSetRow))
    (HUD|DrawTexture :Texture (Utilities|Array|Get(acopy) :Array (Variables|Default|GetUI) :"Dimension 1" 53) :ScreenX (- (* w 0.5) (* h 0.45)) :ScreenY (* h 0.24) :ScreenW (* h 0.9) :ScreenH (* h 0.11) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent")
    (HUD|DrawTexture :Texture (Utilities|Array|Get(acopy) :Array (Variables|Default|GetUI) :"Dimension 1" (+ 29 (+ (* (select (> mi 0.75) 2 (select (> mi 0.25) 1 0)) 2) (select (== srow 0) 1 0)))) :ScreenX (- (* w 0.5) (* h 0.45)) :ScreenY (* h 0.40) :ScreenW (* h 0.9) :ScreenH (* h 0.06) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent")
    (HUD|DrawTexture :Texture (Utilities|Array|Get(acopy) :Array (Variables|Default|GetUI) :"Dimension 1" (+ 35 (+ (* q 2) (select (== srow 1) 1 0)))) :ScreenX (- (* w 0.5) (* h 0.45)) :ScreenY (* h 0.47) :ScreenW (* h 0.9) :ScreenH (* h 0.06) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent")
    (HUD|DrawTexture :Texture (Utilities|Array|Get(acopy) :Array (Variables|Default|GetUI) :"Dimension 1" (+ 43 (+ (* (- (Variables|Default|GetSensLv) 1) 2) (select (== srow 2) 1 0)))) :ScreenX (- (* w 0.5) (* h 0.45)) :ScreenY (* h 0.54) :ScreenW (* h 0.9) :ScreenH (* h 0.06) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent")
    (HUD|DrawTexture :Texture (Utilities|Array|Get(acopy) :Array (Variables|Default|GetUI) :"Dimension 1" 54) :ScreenX (- (* w 0.5) (* h 0.45)) :ScreenY (* h 0.64) :ScreenW (* h 0.9) :ScreenH (* h 0.04) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent"))
  (if (and (== mode 3) (and (== (Variables|Default|GetStep) 2) (< fade 0.5)))
    (HUD|DrawTexture :Texture "/Game/Prints/ui_vague_1.ui_vague_1" :ScreenX (+ 28.0 (* 3.0 (Math|Trig|Sin(Radians) (* 7.0 (Utilities|Time|GetGameTimeinSeconds))))) :ScreenY (- h (* h 0.15))
                     :ScreenW (* h 0.4) :ScreenH (* h 0.125) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent"))
  (if (and (== mode 3) (and (== (Variables|Default|GetStep) 3) (< fade 0.5)))
    (HUD|DrawTexture :Texture "/Game/Prints/ui_vague_2.ui_vague_2" :ScreenX (+ 28.0 (* 3.0 (Math|Trig|Sin(Radians) (* 7.0 (Utilities|Time|GetGameTimeinSeconds))))) :ScreenY (- h (* h 0.15))
                     :ScreenW (* h 0.4) :ScreenH (* h 0.125) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent"))
  (if (and (== mode 3) (and (== (Variables|Default|GetStep) 4) (< fade 0.5)))
    (HUD|DrawTexture :Texture "/Game/Prints/ui_vague_3.ui_vague_3" :ScreenX (+ 28.0 (* 3.0 (Math|Trig|Sin(Radians) (* 7.0 (Utilities|Time|GetGameTimeinSeconds))))) :ScreenY (- h (* h 0.15))
                     :ScreenW (* h 0.4) :ScreenH (* h 0.125) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent"))
  (if (and (== mode 3) (== (Variables|Default|GetStep) 1))
    (HUD|DrawTexture :Texture "/Game/Prints/ui_title_card.ui_title_card" :ScreenX 0.0 :ScreenY (- (* h 0.5) (* w 0.25)) :ScreenW w :ScreenH (* w 0.5)
                     :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0))
  (if (== mode 4)
    (HUD|DrawTexture :Texture "/Game/Prints/ui_end.ui_end" :ScreenX 0.0 :ScreenY (- (* h 0.5) (* w 0.25)) :ScreenW w :ScreenH (* w 0.5)
                     :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0))
  (if (and (== mode 6) (< fade 0.5))
    (bind stk (Math|Float|Truncate :A (.y (Transformation|GetActorLocation :self (Variables|Default|GetLB)))))
    (HUD|DrawTexture :Texture (Utilities|Array|Get(acopy) :Array (Variables|Default|GetUI) :"Dimension 1" (+ 21 (Math|Integer|Min(Integer) :A 4 :B stk))) :ScreenX 28.0 :ScreenY (- h (* h 0.12)) :ScreenW (* h 1.26) :ScreenH (* h 0.09) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent"))
  (if (Variables|Default|GetPaused)
    (HUD|DrawRect :RectColor (Utilities|Struct|MakeLinearColor :R 0.0 :G 0.0 :B 0.0 :A 0.72) :ScreenX 0.0 :ScreenY 0.0 :ScreenW w :ScreenH h)
    (bind pi1 (Variables|Default|GetPauseIdx))
    (HUD|DrawTexture :Texture (Utilities|Array|Get(acopy) :Array (Variables|Default|GetUI) :"Dimension 1" (+ 5 pi1)) :ScreenX (- (* w 0.5) (* h 0.45)) :ScreenY (* h 0.3) :ScreenW (* h 0.9) :ScreenH (* h 0.36) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent"))
  (if (Variables|Default|GetDebug)
    (HUD|DrawRect :RectColor (Utilities|Struct|MakeLinearColor :R 0.1 :G 0.1 :B 0.1 :A 0.8) :ScreenX 20.0 :ScreenY 20.0 :ScreenW 404.0 :ScreenH 66.0)
    (bind pr (Variables|Default|GetPreset))
    (HUD|DrawTexture :Texture (Utilities|Array|Get(acopy) :Array (Variables|Default|GetUI) :"Dimension 1" (+ 26 pr)) :ScreenX 24.0 :ScreenY 70.0 :ScreenW (* h 0.84) :ScreenH (* h 0.06) :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :BlendMode "Translucent")
    (HUD|DrawRect :RectColor (Utilities|Struct|MakeLinearColor :R 0.8 :G 0.3 :B 0.2 :A 1.0) :ScreenX 22.0 :ScreenY 44.0 :ScreenW (* (Variables|Default|GetUnease) 4.0) :ScreenH 16.0)))
