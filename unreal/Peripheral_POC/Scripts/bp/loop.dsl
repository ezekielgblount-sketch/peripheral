; The loop sequence. Jack is never moved: a corridor leaves the upstairs hall by one of the two closet doors at its far end, turns
; round the end of a thin wall and comes back out of the other closet door, so walking on brings him back to where he started. While he is in the
; corridor (the hall out of sight) the hall is changed; while he is in the hall looking away the corridor is put back.
; On some passes the corridor's far wall retreats in front of him as he walks, and the corridor grows.
; The loop blackboard actor carries X = running (set by the director), Y = right calls in a row, Z = finished.
(event EventBeginPlay
  (bind f_LB (Actor|GetAllActorswithTag :Tag "lb"))
  (for a_LB f_LB (Variables|Default|SetLB a_LB))
  (bind f_DA (Actor|GetAllActorswithTag :Tag "s_adoor"))
  (for a_DA f_DA (Variables|Default|SetDoorA a_DA))
  (bind f_DB (Actor|GetAllActorswithTag :Tag "s_bdoor"))
  (for a_DB f_DB (Variables|Default|SetDoorB a_DB))
  (bind f_Clock (Actor|GetAllActorswithTag :Tag "an_clockhand"))
  (for a_Clock f_Clock (Variables|Default|SetClock a_Clock))
  (Variables|Default|SetYawA0 (.yaw (Transformation|GetActorRotation :self (Variables|Default|GetDoorA))))
  (Variables|Default|SetYawB0 (.yaw (Transformation|GetActorRotation :self (Variables|Default|GetDoorB))))
  (Variables|Default|SetK -1)
  (Variables|Default|SetLast -1)
  (Variables|Default|SetGroan (Audio|SpawnSound2D :Sound "/Game/Audio/house_groan.house_groan" :VolumeMultiplier 0.8 :bAutoDestroy false))
  (Audio|Components|Audio|SetPaused :self (Variables|Default|GetGroan) :bPause true)
  (bind gAx (Actor|GetAllActorswithTag :Tag "annex"))
  (for hAx gAx
    (Rendering|SetActorHiddenInGame :self hAx :bNewHidden true)
    (Collision|SetActorEnableCollision :self hAx :bNewActorEnableCollision false))
  (bind gA0 (Actor|GetAllActorswithTag :Tag "an0"))
  (for hA0 gA0 (Rendering|SetActorHiddenInGame :self hA0 :bNewHidden true))
  (bind gA1 (Actor|GetAllActorswithTag :Tag "an1"))
  (for hA1 gA1 (Rendering|SetActorHiddenInGame :self hA1 :bNewHidden true))
  (bind gN1 (Actor|GetAllActorswithTag :Tag "an1n"))
  (for hN1 gN1 (Rendering|SetActorHiddenInGame :self hN1 :bNewHidden true))
  (bind gA2 (Actor|GetAllActorswithTag :Tag "an2"))
  (for hA2 gA2 (Rendering|SetActorHiddenInGame :self hA2 :bNewHidden true))
  (bind gA4 (Actor|GetAllActorswithTag :Tag "an4"))
  (for hA4 gA4 (Rendering|SetActorHiddenInGame :self hA4 :bNewHidden true))
  (bind gA5 (Actor|GetAllActorswithTag :Tag "an5"))
  (for hA5 gA5 (Rendering|SetActorHiddenInGame :self hA5 :bNewHidden true)))

(event EventTick (DeltaSeconds)
  (bind lb (Variables|Default|GetLB))
  (bind on (> (.x (Transformation|GetActorLocation :self lb)) 0.5))
  ; ---------------- the sequence starts: the corridor exists, the house wall in its way does not ----------------
  (if (and on (not (Variables|Default|GetWas)))
    (Variables|Default|SetWas true)
    (bind gAx (Actor|GetAllActorswithTag :Tag "annex"))
    (for hAx gAx
      (Rendering|SetActorHiddenInGame :self hAx :bNewHidden false)
      (Collision|SetActorEnableCollision :self hAx :bNewActorEnableCollision true))
    (bind gHd (Actor|GetAllActorswithTag :Tag "annex_hide"))
    (for hHd gHd
      (Rendering|SetActorHiddenInGame :self hHd :bNewHidden true)
      (Collision|SetActorEnableCollision :self hHd :bNewActorEnableCollision false))
    (bind gN1 (Actor|GetAllActorswithTag :Tag "an1n"))
    (for hN1 gN1 (Rendering|SetActorHiddenInGame :self hN1 :bNewHidden false))
    (Game|Damage|ApplyDamage :DamagedActor (Variables|Default|GetDoorB) :BaseDamage 1.0)
    (Variables|Default|SetS 0.0)
    (Variables|Default|SetSMax 900.0)
    (Variables|Default|SetStretch true))
  (if on
    (bind pawn (Game|GetPlayerPawn :PlayerIndex 0))
    (bind p (Transformation|GetActorLocation :self pawn))
    (bind px (.x p))
    (bind py (.y p))
    (bind up (> (.z p) 300.0))
    (bind fwdY (.y (Math|Vector|GetForwardVector :InRot (Camera|GetCameraRotation :self (Game|GetPlayerCameraManager :PlayerIndex 0)))))
    (bind in1 (and up (and (< py -626.0) (> px 150.0))))
    (bind in2 (and up (and (< py -626.0) (< px 110.0))))
    (bind inX (and up (and (< py -626.0) (and (<= px 150.0) (>= px 110.0)))))
    (bind hall (not (or in1 (or in2 inX))))
    (if (and hall (!= (Variables|Default|GetEntry) 0)) (Variables|Default|SetEntry 0))
    (if (and in1 (== (Variables|Default|GetEntry) 0)) (Variables|Default|SetEntry 1))
    (if (and in2 (== (Variables|Default|GetEntry) 0)) (Variables|Default|SetEntry 2))
    ; ---------------- the corridor grows in front of him (only while he walks in from the hall leg) ----------------
    (Variables|Default|SetMoving false)
    (if (and (Variables|Default|GetStretch) (and in1 (== (Variables|Default|GetEntry) 1)))
      (bind smax (Variables|Default|GetSMax))
      (bind gap (- 430.0 (* 330.0 (/ (Variables|Default|GetS) smax))))
      (bind want (Math|Float|Clamp(Float) :Value (+ (- (- 1150.0 py) 2100.0) gap) :Min 0.0 :Max smax))
      (Variables|Default|SetMoving (> (- want (Variables|Default|GetS)) 6.0))
      (Variables|Default|SetS (Math|Float|Max(Float) :A (Variables|Default|GetS) :B (Math|Interpolation|FInterpTo :Current (Variables|Default|GetS) :Target want :DeltaTime DeltaSeconds :InterpSpeed 4.0))))
    (Audio|Components|Audio|SetPaused :self (Variables|Default|GetGroan) :bPause (not (Variables|Default|GetMoving)))
    (Rendering|Material|SetScalarParameterValue :Collection "/Game/Materials/MPC_World.MPC_World" :ParameterName "Pulse" :ParameterValue (select (Variables|Default|GetMoving) 2.0 0.0))
    ; back in the hall and looking away: the corridor is short again
    (if (and hall (and (> (Variables|Default|GetS) 0.0) (> fwdY 0.35))) (Variables|Default|SetS 0.0))
    ; ---------------- half way round, both ends out of sight: the call is counted and the hall is changed ----------------
    (if (or (and (== (Variables|Default|GetEntry) 1) in2) (and (== (Variables|Default|GetEntry) 2) in1))
      (Variables|Default|SetOk (or (and (>= (Variables|Default|GetK) 0) (== (Variables|Default|GetEntry) 2)) (and (< (Variables|Default|GetK) 0) (== (Variables|Default|GetEntry) 1))))
      (Variables|Default|SetEntry 3)
      (Variables|Default|SetStreak (select (Variables|Default|GetOk) (+ (Variables|Default|GetStreak) 1) 0))
      (if (Variables|Default|GetOk)
        (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.5)
        (else (Audio|PlaySound2D :Sound "/Game/Audio/box_thump.box_thump" :VolumeMultiplier 0.7)))
      ; the doors shut behind him
      (if (> (Math|Float|Absolute(Float) (- (.yaw (Transformation|GetActorRotation :self (Variables|Default|GetDoorA))) (Variables|Default|GetYawA0))) 8.0)
        (Game|Damage|ApplyDamage :DamagedActor (Variables|Default|GetDoorA) :BaseDamage 1.0))
      (if (> (Math|Float|Absolute(Float) (- (.yaw (Transformation|GetActorRotation :self (Variables|Default|GetDoorB))) (Variables|Default|GetYawB0))) 8.0)
        (Game|Damage|ApplyDamage :DamagedActor (Variables|Default|GetDoorB) :BaseDamage 1.0))
      ; what is wrong with the hall next time round (often nothing; never the same thing twice running)
      (bind r6 (Math|Random|RandomFloatinRange :Min 0.0 :Max 5.999))
      (Variables|Default|SetCand (select (< r6 1.0) 0 (select (< r6 2.0) 1 (select (< r6 3.0) 2 (select (< r6 4.0) 3 (select (< r6 5.0) 4 5))))))
      (if (== (Variables|Default|GetCand) (Variables|Default|GetLast)) (Variables|Default|SetCand (select (== (Variables|Default|GetCand) 5) 0 (+ (Variables|Default|GetCand) 1))))
      (Variables|Default|SetK (select (< (Math|Random|RandomFloatinRange :Min 0.0 :Max 1.0) 0.6) (Variables|Default|GetCand) -1))
      (if (>= (Variables|Default|GetK) 0) (Variables|Default|SetLast (Variables|Default|GetK)))
      (bind k (Variables|Default|GetK))
      (bind gA0 (Actor|GetAllActorswithTag :Tag "an0"))
      (for hA0 gA0 (Rendering|SetActorHiddenInGame :self hA0 :bNewHidden (!= k 0)))
      (bind gA1 (Actor|GetAllActorswithTag :Tag "an1"))
      (for hA1 gA1 (Rendering|SetActorHiddenInGame :self hA1 :bNewHidden (!= k 1)))
      (bind gN1 (Actor|GetAllActorswithTag :Tag "an1n"))
      (for hN1 gN1 (Rendering|SetActorHiddenInGame :self hN1 :bNewHidden (== k 1)))
      (bind gA2 (Actor|GetAllActorswithTag :Tag "an2"))
      (for hA2 gA2 (Rendering|SetActorHiddenInGame :self hA2 :bNewHidden (!= k 2)))
      (bind gN2 (Actor|GetAllActorswithTag :Tag "an2n"))
      (for hN2 gN2 (Rendering|SetActorHiddenInGame :self hN2 :bNewHidden (== k 2)))
      (bind gA4 (Actor|GetAllActorswithTag :Tag "an4"))
      (for hA4 gA4 (Rendering|SetActorHiddenInGame :self hA4 :bNewHidden (!= k 4)))
      (bind gA5 (Actor|GetAllActorswithTag :Tag "an5"))
      (for hA5 gA5 (Rendering|SetActorHiddenInGame :self hA5 :bNewHidden (!= k 5)))
      ; and whether the corridor will grow on the next pass, and how far
      (Variables|Default|SetStretch (< (Math|Random|RandomFloatinRange :Min 0.0 :Max 1.0) 0.45))
      (Variables|Default|SetSMax (Math|Random|RandomFloatinRange :Min 380.0 :Max 900.0)))
    ; ---------------- put the moving parts where the corridor's length says they are ----------------
    (bind face (- -950.0 (Variables|Default|GetS)))
    (bind gW (Actor|GetAllActorswithTag :Tag "ax_capw"))
    (for aW gW (Transformation|SetActorLocation :self aW :NewLocation (Math|Vector|MakeVector :X (.x (Transformation|GetActorLocation :self aW)) :Y (- face 6.0) :Z (.z (Transformation|GetActorLocation :self aW)))))
    (bind gC (Actor|GetAllActorswithTag :Tag "ax_cap"))
    (for aC gC (Transformation|SetActorLocation :self aC :NewLocation (Math|Vector|MakeVector :X (.x (Transformation|GetActorLocation :self aC)) :Y face :Z (.z (Transformation|GetActorLocation :self aC)))))
    (bind gL (Actor|GetAllActorswithTag :Tag "ax_l0"))
    (for aL gL (Transformation|SetActorLocation :self aL :NewLocation (Math|Vector|MakeVector :X (.x (Transformation|GetActorLocation :self aL)) :Y (+ face 55.0) :Z (.z (Transformation|GetActorLocation :self aL)))))
    (bind gD (Actor|GetAllActorswithTag :Tag "ax_div"))
    (for aD gD
      (Transformation|SetActorLocation :self aD :NewLocation (Math|Vector|MakeVector :X (.x (Transformation|GetActorLocation :self aD)) :Y (- -820.0 (* 0.5 (Variables|Default|GetS))) :Z (.z (Transformation|GetActorLocation :self aD))))
      (Transformation|SetActorScale3D :self aD :NewScale3D (Math|Vector|MakeVector :X (.x (Transformation|GetActorScale3D :self aD)) :Y (/ (+ 20.0 (Variables|Default|GetS)) 100.0) :Z (.z (Transformation|GetActorScale3D :self aD)))))
    (bind gL1 (Actor|GetAllActorswithTag :Tag "ax_l1"))
    (for aL1 gL1 (Rendering|SetActorHiddenInGame :self aL1 :bNewHidden (> face -1310.0)))
    (bind gL2 (Actor|GetAllActorswithTag :Tag "ax_l2"))
    (for aL2 gL2 (Rendering|SetActorHiddenInGame :self aL2 :bNewHidden (> face -1710.0)))
    ; the hall clock: its second hand runs backward when that is the thing that is wrong
    (Variables|Default|SetClockA (+ (Variables|Default|GetClockA) (* DeltaSeconds (select (== (Variables|Default|GetK) 3) -42.0 6.0))))
    (Transformation|SetActorRotation :self (Variables|Default|GetClock) :NewRotation (Math|Rotator|MakeRotator :Roll (Variables|Default|GetClockA) :Pitch 0.0 :Yaw 90.0))
    ; report to the director: the count, and the end once he is back in the hall after the fifth right call
    (Transformation|SetActorLocation :self lb :NewLocation (Math|Vector|MakeVector :X 1.0 :Y (Math|Conversions|ToFloat(Integer) (Variables|Default|GetStreak)) :Z (select (and hall (>= (Variables|Default|GetStreak) 5)) 1.0 0.0)))))
