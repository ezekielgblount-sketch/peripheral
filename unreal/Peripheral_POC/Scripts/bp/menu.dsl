(event UserInterface|EventConstruct
  (bind f_UB (Actor|GetAllActorswithTag :Tag "ub")) (for a_UB f_UB (Variables|Default|SetUB a_UB))
  (bind f_BB (Actor|GetAllActorswithTag :Tag "bb")) (for a_BB f_BB (Variables|Default|SetBB a_BB))
  (bind f_SB (Actor|GetAllActorswithTag :Tag "sb")) (for a_SB f_SB (Variables|Default|SetSB a_SB))
  (bind f_CP (Actor|GetAllActorswithTag :Tag "cp")) (for a_CP f_CP (Variables|Default|SetCP a_CP))
  (bind f_QB (Actor|GetAllActorswithTag :Tag "qb")) (for a_QB f_QB (Variables|Default|SetQB a_QB))
  (if (not (SaveGame|DoesSaveGameExist :SlotName "settings" :UserIndex 0))
    (SaveGame|SaveGametoSlot :SaveGameObject (SaveGame|CreateSaveGameObject :SaveGameClass "/Game/Blueprints/BP_SaveSettings.BP_SaveSettings_C") :SlotName "settings" :UserIndex 0))
  (bind sv0 (Utilities|Casting|CastToBP_SaveSettings :Object (SaveGame|LoadGamefromSlot :SlotName "settings" :UserIndex 0))
    (:then (Variables|Default|SetSave sv0) (Variables|Default|SetReady true))
    (:CastFailed)))

(event UserInterface|EventTick (MyGeometry InDeltaTime)
  (bind ub (Variables|Default|GetUB))
  (bind ubl (Transformation|GetActorLocation :self ub))
  (bind screen (Math|Float|Round :A (.x ubl)))
  (if (== screen 1) (Widget|SetVisibility :self (Variables|WBP_Menu|GetTitleBox) :InVisibility "Visible") (else (Widget|SetVisibility :self (Variables|WBP_Menu|GetTitleBox) :InVisibility "Collapsed")))
  (if (== screen 2) (Widget|SetVisibility :self (Variables|WBP_Menu|GetPauseBox) :InVisibility "Visible") (else (Widget|SetVisibility :self (Variables|WBP_Menu|GetPauseBox) :InVisibility "Collapsed")))
  (if (== screen 3) (Widget|SetVisibility :self (Variables|WBP_Menu|GetSettingsBox) :InVisibility "Visible") (else (Widget|SetVisibility :self (Variables|WBP_Menu|GetSettingsBox) :InVisibility "Collapsed")))
  (if (== screen 4) (Widget|SetVisibility :self (Variables|WBP_Menu|GetHowBox) :InVisibility "Visible") (else (Widget|SetVisibility :self (Variables|WBP_Menu|GetHowBox) :InVisibility "Collapsed")))
  (if (== screen 5) (Widget|SetVisibility :self (Variables|WBP_Menu|GetChapterBox) :InVisibility "Visible") (else (Widget|SetVisibility :self (Variables|WBP_Menu|GetChapterBox) :InVisibility "Collapsed")))
  (if (> screen 1) (Widget|SetVisibility :self (Variables|WBP_Menu|GetDim) :InVisibility "Visible") (else (Widget|SetVisibility :self (Variables|WBP_Menu|GetDim) :InVisibility "Collapsed")))
  (bind page (Variables|Default|GetPage))
  (if (== page 0) (Widget|SetVisibility :self (Variables|WBP_Menu|GetPage0) :InVisibility "Visible") (else (Widget|SetVisibility :self (Variables|WBP_Menu|GetPage0) :InVisibility "Collapsed"))) (if (== page 1) (Widget|SetVisibility :self (Variables|WBP_Menu|GetPage1) :InVisibility "Visible") (else (Widget|SetVisibility :self (Variables|WBP_Menu|GetPage1) :InVisibility "Collapsed"))) (if (== page 2) (Widget|SetVisibility :self (Variables|WBP_Menu|GetPage2) :InVisibility "Visible") (else (Widget|SetVisibility :self (Variables|WBP_Menu|GetPage2) :InVisibility "Collapsed"))) (if (== page 3) (Widget|SetVisibility :self (Variables|WBP_Menu|GetPage3) :InVisibility "Visible") (else (Widget|SetVisibility :self (Variables|WBP_Menu|GetPage3) :InVisibility "Collapsed"))) (if (== page 4) (Widget|SetVisibility :self (Variables|WBP_Menu|GetPage4) :InVisibility "Visible") (else (Widget|SetVisibility :self (Variables|WBP_Menu|GetPage4) :InVisibility "Collapsed")))
  ; keyboard and controller: give the first button of a screen the focus when that screen opens
  (bind last (Variables|Default|GetLastScreen))
  (if (!= screen last)
    (Variables|Default|SetLastScreen screen)
    (if (== screen 1) (Widget|SetFocus :self (Variables|WBP_Menu|GetBtnDay1)))
    (if (== screen 2) (Widget|SetFocus :self (Variables|WBP_Menu|GetBtnResume)))
    (if (== screen 3) (Widget|SetFocus :self (Variables|WBP_Menu|GetBtnTab0)))
    (if (== screen 4) (Widget|SetFocus :self (Variables|WBP_Menu|GetBtnHowBack)))
    (if (and (== last 3) (Variables|Default|GetInited))
      (SaveGame|SaveGametoSlot :SaveGameObject (Variables|Default|GetSave) :SlotName "settings" :UserIndex 0)))
  (if (and (Variables|Default|GetReady) (Variables|Default|GetHavePlayer))
    (bind sv (Variables|Default|GetSave))
    (bind pl (Variables|Default|GetPlayerRef))
    (if (not (Variables|Default|GetInited))
      ; first frame: put the saved values on the controls and switch them all on
      (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCWinMode) :Index (Class|BPSaveSettings|GetWinMode :self sv))
      (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCRes) :Index (Class|BPSaveSettings|GetRes :self sv))
      (Widget|SetIsChecked :self (Variables|WBP_Menu|GetCVSync) :InIsChecked (Class|BPSaveSettings|GetVSync :self sv))
      (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCFpsCap) :Index (Class|BPSaveSettings|GetFpsCap :self sv))
      (Class|Slider|SetValue :self (Variables|WBP_Menu|GetCFov) :Value (Class|BPSaveSettings|GetFov :self sv))
      (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCPreset) :Index (Class|BPSaveSettings|GetPreset :self sv))
      (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCShadows) :Index (Class|BPSaveSettings|GetShadows :self sv))
      (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCGI) :Index (Class|BPSaveSettings|GetGI :self sv))
      (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCRefl) :Index (Class|BPSaveSettings|GetRefl :self sv))
      (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCTex) :Index (Class|BPSaveSettings|GetTex :self sv))
      (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCFx) :Index (Class|BPSaveSettings|GetFx :self sv))
      (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCPost) :Index (Class|BPSaveSettings|GetPost :self sv))
      (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCAA) :Index (Class|BPSaveSettings|GetAA :self sv))
      (Class|Slider|SetValue :self (Variables|WBP_Menu|GetCScale) :Value (Class|BPSaveSettings|GetScale :self sv))
      (Class|Slider|SetValue :self (Variables|WBP_Menu|GetCMaster) :Value (Class|BPSaveSettings|GetMaster :self sv))
      (Class|Slider|SetValue :self (Variables|WBP_Menu|GetCMusic) :Value (Class|BPSaveSettings|GetMusic :self sv))
      (Class|Slider|SetValue :self (Variables|WBP_Menu|GetCSfx) :Value (Class|BPSaveSettings|GetSfx :self sv))
      (Class|Slider|SetValue :self (Variables|WBP_Menu|GetCAmb) :Value (Class|BPSaveSettings|GetAmb :self sv))
      (Class|Slider|SetValue :self (Variables|WBP_Menu|GetCSens) :Value (Class|BPSaveSettings|GetSens :self sv))
      (Widget|SetIsChecked :self (Variables|WBP_Menu|GetCInvert) :InIsChecked (Class|BPSaveSettings|GetInvert :self sv))
      (Widget|SetSelectedKey :self (Variables|WBP_Menu|GetCKFwd) :InSelectedKey (Utilities|Struct|MakeInputChord :Key (Class|BPSaveSettings|GetKFwd :self sv) :bShift false :bCtrl false :bAlt false :bCmd false))
      (Widget|SetSelectedKey :self (Variables|WBP_Menu|GetCKBack) :InSelectedKey (Utilities|Struct|MakeInputChord :Key (Class|BPSaveSettings|GetKBack :self sv) :bShift false :bCtrl false :bAlt false :bCmd false))
      (Widget|SetSelectedKey :self (Variables|WBP_Menu|GetCKLeft) :InSelectedKey (Utilities|Struct|MakeInputChord :Key (Class|BPSaveSettings|GetKLeft :self sv) :bShift false :bCtrl false :bAlt false :bCmd false))
      (Widget|SetSelectedKey :self (Variables|WBP_Menu|GetCKRight) :InSelectedKey (Utilities|Struct|MakeInputChord :Key (Class|BPSaveSettings|GetKRight :self sv) :bShift false :bCtrl false :bAlt false :bCmd false))
      (Widget|SetSelectedKey :self (Variables|WBP_Menu|GetCKUse) :InSelectedKey (Utilities|Struct|MakeInputChord :Key (Class|BPSaveSettings|GetKUse :self sv) :bShift false :bCtrl false :bAlt false :bCmd false))
      (Widget|SetSelectedKey :self (Variables|WBP_Menu|GetCKCrouch) :InSelectedKey (Utilities|Struct|MakeInputChord :Key (Class|BPSaveSettings|GetKCrouch :self sv) :bShift false :bCtrl false :bAlt false :bCmd false))
      (Widget|SetSelectedKey :self (Variables|WBP_Menu|GetCKLight) :InSelectedKey (Utilities|Struct|MakeInputChord :Key (Class|BPSaveSettings|GetKLight :self sv) :bShift false :bCtrl false :bAlt false :bCmd false))
      (Class|Slider|SetValue :self (Variables|WBP_Menu|GetCMotion) :Value (Class|BPSaveSettings|GetMotion :self sv))
      (Class|Slider|SetValue :self (Variables|WBP_Menu|GetCCap) :Value (Class|BPSaveSettings|GetCap :self sv))
      (Widget|SetIsChecked :self (Variables|WBP_Menu|GetCSubs) :InIsChecked (Class|BPSaveSettings|GetSubs :self sv))
      (Audio|PushSoundMixModifier :InSoundMixModifier "/Game/Audio/Mix_Settings.Mix_Settings")
      (Class|BPPlayer|SetKFwd :self pl :KFwd (Class|BPSaveSettings|GetKFwd :self sv)) (Class|BPPlayer|SetKBack :self pl :KBack (Class|BPSaveSettings|GetKBack :self sv)) (Class|BPPlayer|SetKLeft :self pl :KLeft (Class|BPSaveSettings|GetKLeft :self sv)) (Class|BPPlayer|SetKRight :self pl :KRight (Class|BPSaveSettings|GetKRight :self sv)) (Class|BPPlayer|SetKUse :self pl :KUse (Class|BPSaveSettings|GetKUse :self sv)) (Class|BPPlayer|SetKCrouch :self pl :KCrouch (Class|BPSaveSettings|GetKCrouch :self sv)) (Class|BPPlayer|SetKLight :self pl :KLight (Class|BPSaveSettings|GetKLight :self sv))
      (Variables|Default|SetGusDirty true)
      (Variables|Default|SetInited true))
    (if (== screen 3)
      (bind i_WinMode (ComboBox|GetSelectedIndex :self (Variables|WBP_Menu|GetCWinMode)))
      (if (!= i_WinMode (Class|BPSaveSettings|GetWinMode :self sv)) (Class|BPSaveSettings|SetWinMode :self sv :WinMode i_WinMode) (Variables|Default|SetGusDirty true))
      (bind i_Res (ComboBox|GetSelectedIndex :self (Variables|WBP_Menu|GetCRes)))
      (if (!= i_Res (Class|BPSaveSettings|GetRes :self sv)) (Class|BPSaveSettings|SetRes :self sv :Res i_Res) (Variables|Default|SetGusDirty true))
      (bind b_VSync (Widget|IsChecked :self (Variables|WBP_Menu|GetCVSync)))
      (if (!= b_VSync (Class|BPSaveSettings|GetVSync :self sv)) (Class|BPSaveSettings|SetVSync :self sv :VSync b_VSync) (Variables|Default|SetGusDirty true))
      (bind i_FpsCap (ComboBox|GetSelectedIndex :self (Variables|WBP_Menu|GetCFpsCap)))
      (if (!= i_FpsCap (Class|BPSaveSettings|GetFpsCap :self sv)) (Class|BPSaveSettings|SetFpsCap :self sv :FpsCap i_FpsCap) (Variables|Default|SetGusDirty true))
      (bind f_Fov (Class|Slider|GetValue :self (Variables|WBP_Menu|GetCFov)))
      (if (!= f_Fov (Class|BPSaveSettings|GetFov :self sv)) (Class|BPSaveSettings|SetFov :self sv :Fov f_Fov))
      (Widget|SetText(Text) :self (Variables|WBP_Menu|GetValFov) :InText (Utilities|Text|ToText(Integer) :Value (Math|Float|Round :A f_Fov)))
      (bind i_Preset (ComboBox|GetSelectedIndex :self (Variables|WBP_Menu|GetCPreset)))
      (if (!= i_Preset (Class|BPSaveSettings|GetPreset :self sv)) (Class|BPSaveSettings|SetPreset :self sv :Preset i_Preset) (if (< i_Preset 4) (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCShadows) :Index i_Preset) (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCGI) :Index i_Preset) (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCRefl) :Index i_Preset) (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCTex) :Index i_Preset) (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCFx) :Index i_Preset) (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCPost) :Index i_Preset) (ComboBox|SetSelectedIndex :self (Variables|WBP_Menu|GetCAA) :Index i_Preset)))
      (bind i_Shadows (ComboBox|GetSelectedIndex :self (Variables|WBP_Menu|GetCShadows)))
      (if (!= i_Shadows (Class|BPSaveSettings|GetShadows :self sv)) (Class|BPSaveSettings|SetShadows :self sv :Shadows i_Shadows) (Variables|Default|SetGusDirty true))
      (bind i_GI (ComboBox|GetSelectedIndex :self (Variables|WBP_Menu|GetCGI)))
      (if (!= i_GI (Class|BPSaveSettings|GetGI :self sv)) (Class|BPSaveSettings|SetGI :self sv :GI i_GI) (Variables|Default|SetGusDirty true))
      (bind i_Refl (ComboBox|GetSelectedIndex :self (Variables|WBP_Menu|GetCRefl)))
      (if (!= i_Refl (Class|BPSaveSettings|GetRefl :self sv)) (Class|BPSaveSettings|SetRefl :self sv :Refl i_Refl) (Variables|Default|SetGusDirty true))
      (bind i_Tex (ComboBox|GetSelectedIndex :self (Variables|WBP_Menu|GetCTex)))
      (if (!= i_Tex (Class|BPSaveSettings|GetTex :self sv)) (Class|BPSaveSettings|SetTex :self sv :Tex i_Tex) (Variables|Default|SetGusDirty true))
      (bind i_Fx (ComboBox|GetSelectedIndex :self (Variables|WBP_Menu|GetCFx)))
      (if (!= i_Fx (Class|BPSaveSettings|GetFx :self sv)) (Class|BPSaveSettings|SetFx :self sv :Fx i_Fx) (Variables|Default|SetGusDirty true))
      (bind i_Post (ComboBox|GetSelectedIndex :self (Variables|WBP_Menu|GetCPost)))
      (if (!= i_Post (Class|BPSaveSettings|GetPost :self sv)) (Class|BPSaveSettings|SetPost :self sv :Post i_Post) (Variables|Default|SetGusDirty true))
      (bind i_AA (ComboBox|GetSelectedIndex :self (Variables|WBP_Menu|GetCAA)))
      (if (!= i_AA (Class|BPSaveSettings|GetAA :self sv)) (Class|BPSaveSettings|SetAA :self sv :AA i_AA) (Variables|Default|SetGusDirty true))
      (bind f_Scale (Class|Slider|GetValue :self (Variables|WBP_Menu|GetCScale)))
      (if (!= f_Scale (Class|BPSaveSettings|GetScale :self sv)) (Class|BPSaveSettings|SetScale :self sv :Scale f_Scale) (Variables|Default|SetGusDirty true))
      (Widget|SetText(Text) :self (Variables|WBP_Menu|GetValScale) :InText (Utilities|Text|ToText(Integer) :Value (Math|Float|Round :A f_Scale)))
      (bind f_Master (Class|Slider|GetValue :self (Variables|WBP_Menu|GetCMaster)))
      (if (!= f_Master (Class|BPSaveSettings|GetMaster :self sv)) (Class|BPSaveSettings|SetMaster :self sv :Master f_Master))
      (Widget|SetText(Text) :self (Variables|WBP_Menu|GetValMaster) :InText (Utilities|Text|ToText(Integer) :Value (Math|Float|Round :A (* f_Master 100.0))))
      (bind f_Music (Class|Slider|GetValue :self (Variables|WBP_Menu|GetCMusic)))
      (if (!= f_Music (Class|BPSaveSettings|GetMusic :self sv)) (Class|BPSaveSettings|SetMusic :self sv :Music f_Music))
      (Widget|SetText(Text) :self (Variables|WBP_Menu|GetValMusic) :InText (Utilities|Text|ToText(Integer) :Value (Math|Float|Round :A (* f_Music 100.0))))
      (bind f_Sfx (Class|Slider|GetValue :self (Variables|WBP_Menu|GetCSfx)))
      (if (!= f_Sfx (Class|BPSaveSettings|GetSfx :self sv)) (Class|BPSaveSettings|SetSfx :self sv :Sfx f_Sfx))
      (Widget|SetText(Text) :self (Variables|WBP_Menu|GetValSfx) :InText (Utilities|Text|ToText(Integer) :Value (Math|Float|Round :A (* f_Sfx 100.0))))
      (bind f_Amb (Class|Slider|GetValue :self (Variables|WBP_Menu|GetCAmb)))
      (if (!= f_Amb (Class|BPSaveSettings|GetAmb :self sv)) (Class|BPSaveSettings|SetAmb :self sv :Amb f_Amb))
      (Widget|SetText(Text) :self (Variables|WBP_Menu|GetValAmb) :InText (Utilities|Text|ToText(Integer) :Value (Math|Float|Round :A (* f_Amb 100.0))))
      (bind f_Sens (Class|Slider|GetValue :self (Variables|WBP_Menu|GetCSens)))
      (if (!= f_Sens (Class|BPSaveSettings|GetSens :self sv)) (Class|BPSaveSettings|SetSens :self sv :Sens f_Sens))
      (Widget|SetText(Text) :self (Variables|WBP_Menu|GetValSens) :InText (Utilities|Text|ToText(Integer) :Value (Math|Float|Round :A (* f_Sens 100.0))))
      (bind b_Invert (Widget|IsChecked :self (Variables|WBP_Menu|GetCInvert)))
      (if (!= b_Invert (Class|BPSaveSettings|GetInvert :self sv)) (Class|BPSaveSettings|SetInvert :self sv :Invert b_Invert))
      (bind (k_KFwd s1_KFwd s2_KFwd s3_KFwd s4_KFwd) (Utilities|Struct|BreakInputChord :InputChord (Class|InputKeySelector|GetSelectedKey :self (Variables|WBP_Menu|GetCKFwd))))
      (Class|BPSaveSettings|SetKFwd :self sv :KFwd k_KFwd)
      (Class|BPPlayer|SetKFwd :self pl :KFwd k_KFwd)
      (bind (k_KBack s1_KBack s2_KBack s3_KBack s4_KBack) (Utilities|Struct|BreakInputChord :InputChord (Class|InputKeySelector|GetSelectedKey :self (Variables|WBP_Menu|GetCKBack))))
      (Class|BPSaveSettings|SetKBack :self sv :KBack k_KBack)
      (Class|BPPlayer|SetKBack :self pl :KBack k_KBack)
      (bind (k_KLeft s1_KLeft s2_KLeft s3_KLeft s4_KLeft) (Utilities|Struct|BreakInputChord :InputChord (Class|InputKeySelector|GetSelectedKey :self (Variables|WBP_Menu|GetCKLeft))))
      (Class|BPSaveSettings|SetKLeft :self sv :KLeft k_KLeft)
      (Class|BPPlayer|SetKLeft :self pl :KLeft k_KLeft)
      (bind (k_KRight s1_KRight s2_KRight s3_KRight s4_KRight) (Utilities|Struct|BreakInputChord :InputChord (Class|InputKeySelector|GetSelectedKey :self (Variables|WBP_Menu|GetCKRight))))
      (Class|BPSaveSettings|SetKRight :self sv :KRight k_KRight)
      (Class|BPPlayer|SetKRight :self pl :KRight k_KRight)
      (bind (k_KUse s1_KUse s2_KUse s3_KUse s4_KUse) (Utilities|Struct|BreakInputChord :InputChord (Class|InputKeySelector|GetSelectedKey :self (Variables|WBP_Menu|GetCKUse))))
      (Class|BPSaveSettings|SetKUse :self sv :KUse k_KUse)
      (Class|BPPlayer|SetKUse :self pl :KUse k_KUse)
      (bind (k_KCrouch s1_KCrouch s2_KCrouch s3_KCrouch s4_KCrouch) (Utilities|Struct|BreakInputChord :InputChord (Class|InputKeySelector|GetSelectedKey :self (Variables|WBP_Menu|GetCKCrouch))))
      (Class|BPSaveSettings|SetKCrouch :self sv :KCrouch k_KCrouch)
      (Class|BPPlayer|SetKCrouch :self pl :KCrouch k_KCrouch)
      (bind (k_KLight s1_KLight s2_KLight s3_KLight s4_KLight) (Utilities|Struct|BreakInputChord :InputChord (Class|InputKeySelector|GetSelectedKey :self (Variables|WBP_Menu|GetCKLight))))
      (Class|BPSaveSettings|SetKLight :self sv :KLight k_KLight)
      (Class|BPPlayer|SetKLight :self pl :KLight k_KLight)
      (bind f_Motion (Class|Slider|GetValue :self (Variables|WBP_Menu|GetCMotion)))
      (if (!= f_Motion (Class|BPSaveSettings|GetMotion :self sv)) (Class|BPSaveSettings|SetMotion :self sv :Motion f_Motion))
      (Widget|SetText(Text) :self (Variables|WBP_Menu|GetValMotion) :InText (Utilities|Text|ToText(Integer) :Value (Math|Float|Round :A (* f_Motion 100.0))))
      (bind f_Cap (Class|Slider|GetValue :self (Variables|WBP_Menu|GetCCap)))
      (if (!= f_Cap (Class|BPSaveSettings|GetCap :self sv)) (Class|BPSaveSettings|SetCap :self sv :Cap f_Cap))
      (Widget|SetText(Text) :self (Variables|WBP_Menu|GetValCap) :InText (Utilities|Text|ToText(Integer) :Value (Math|Float|Round :A (* f_Cap 100.0))))
      (bind b_Subs (Widget|IsChecked :self (Variables|WBP_Menu|GetCSubs)))
      (if (!= b_Subs (Class|BPSaveSettings|GetSubs :self sv)) (Class|BPSaveSettings|SetSubs :self sv :Subs b_Subs)))
    (if (or (== screen 3) (< (Utilities|Time|GetGameTimeinSeconds) 2.0))
      ; cheap ones are simply written every frame while the settings are open
      (bind bbl (Transformation|GetActorLocation :self (Variables|Default|GetBB)))
      (Transformation|SetActorLocation :self (Variables|Default|GetBB) :NewLocation (Math|Vector|MakeVector :X (Class|BPSaveSettings|GetMotion :self sv) :Y (Class|BPSaveSettings|GetSens :self sv) :Z (.z bbl)))
      (Transformation|SetActorLocation :self (Variables|Default|GetSB) :NewLocation (Math|Vector|MakeVector :X (Class|BPSaveSettings|GetFov :self sv) :Y (select (Class|BPSaveSettings|GetInvert :self sv) -1.0 1.0) :Z (Class|BPSaveSettings|GetCap :self sv)))
      (bind cpl (Transformation|GetActorLocation :self (Variables|Default|GetCP)))
      (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X (.x cpl) :Y (.y cpl) :Z (select (Class|BPSaveSettings|GetSubs :self sv) 1.0 0.0)))
      (Audio|SetSoundMixClassOverride :InSoundMixModifier "/Game/Audio/Mix_Settings.Mix_Settings" :InSoundClass "/Game/Audio/SC_Music.SC_Music" :Volume (* (Class|BPSaveSettings|GetMaster :self sv) (Class|BPSaveSettings|GetMusic :self sv)) :Pitch 1.0 :FadeInTime 0.05 :bApplyToChildren true) (Audio|SetSoundMixClassOverride :InSoundMixModifier "/Game/Audio/Mix_Settings.Mix_Settings" :InSoundClass "/Game/Audio/SC_SFX.SC_SFX" :Volume (* (Class|BPSaveSettings|GetMaster :self sv) (Class|BPSaveSettings|GetSfx :self sv)) :Pitch 1.0 :FadeInTime 0.05 :bApplyToChildren true) (Audio|SetSoundMixClassOverride :InSoundMixModifier "/Game/Audio/Mix_Settings.Mix_Settings" :InSoundClass "/Game/Audio/SC_Ambience.SC_Ambience" :Volume (* (Class|BPSaveSettings|GetMaster :self sv) (Class|BPSaveSettings|GetAmb :self sv)) :Pitch 1.0 :FadeInTime 0.05 :bApplyToChildren true))
    (if (Variables|Default|GetGusDirty)
      (bind gus (Settings|GetGameUserSettings))
      (bind wm (Class|BPSaveSettings|GetWinMode :self sv))
      (if (== wm 0) (Settings|SetFullscreenMode :self gus :InFullscreenMode "Windowed") (elif (== wm 1) (Settings|SetFullscreenMode :self gus :InFullscreenMode "WindowedFullscreen") (else (Settings|SetFullscreenMode :self gus :InFullscreenMode "Fullscreen"))))
      (bind ri (Class|BPSaveSettings|GetRes :self sv))
      (Settings|SetScreenResolution :self gus :Resolution (Utilities|Struct|MakeIntPoint :X (select (== ri 0) 1280 (select (== ri 1) 1600 (select (== ri 2) 1920 (select (== ri 3) 2560 (select (== ri 4) 3024 3840))))) :Y (select (== ri 0) 720 (select (== ri 1) 900 (select (== ri 2) 1080 (select (== ri 3) 1440 (select (== ri 4) 1964 2160)))))))
      (Settings|SetVSyncEnabled :self gus :bEnable (Class|BPSaveSettings|GetVSync :self sv))
      (Settings|SetFrameRateLimit :self gus :NewLimit (select (== (Class|BPSaveSettings|GetFpsCap :self sv) 0) 30.0 (select (== (Class|BPSaveSettings|GetFpsCap :self sv) 1) 60.0 (select (== (Class|BPSaveSettings|GetFpsCap :self sv) 2) 120.0 0.0))))
      (Settings|SetResolutionScaleNormalized :self gus :NewScaleNormalized (/ (Class|BPSaveSettings|GetScale :self sv) 100.0))
      (Settings|SetShadowQuality :self gus :Value (Class|BPSaveSettings|GetShadows :self sv))
      (Settings|SetGlobalIlluminationQuality :self gus :Value (Class|BPSaveSettings|GetGI :self sv))
      (Settings|SetReflectionQuality :self gus :Value (Class|BPSaveSettings|GetRefl :self sv))
      (Settings|SetTextureQuality :self gus :Value (Class|BPSaveSettings|GetTex :self sv))
      (Settings|SetVisualEffectQuality :self gus :Value (Class|BPSaveSettings|GetFx :self sv))
      (Settings|SetPostProcessingQuality :self gus :Value (Class|BPSaveSettings|GetPost :self sv))
      (Settings|SetAntiAliasingQuality :self gus :Value (Class|BPSaveSettings|GetAA :self sv))
      (Settings|ApplySettings :self gus :bCheckForCommandLineOverrides false)
      (Variables|Default|SetGusDirty false)))
  (if (not (Variables|Default|GetHavePlayer))
    (bind pl0 (Utilities|Casting|CastToBP_Player :Object (Player|GetOwningPlayerPawn))
      (:then (Variables|Default|SetPlayerRef pl0) (Variables|Default|SetHavePlayer true))
      (:CastFailed))))

(event OnClicked(BtnDay1)
  (bind l (Transformation|GetActorLocation :self (Variables|Default|GetUB)))
  (Transformation|SetActorLocation :self (Variables|Default|GetUB) :NewLocation (Math|Vector|MakeVector :X (.x l) :Y 1.0 :Z (.z l))))

(event OnClicked(BtnChore)
  (bind l (Transformation|GetActorLocation :self (Variables|Default|GetUB)))
