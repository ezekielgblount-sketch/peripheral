(event UserInterface|EventConstruct
  (bind f_CB (Actor|GetAllActorswithTag :Tag "cb")) (for a_CB f_CB (Variables|Default|SetCB a_CB))
  (bind f_DB (Actor|GetAllActorswithTag :Tag "db")) (for a_DB f_DB (Variables|Default|SetDB a_DB))
  (bind f_CP (Actor|GetAllActorswithTag :Tag "cp")) (for a_CP f_CP (Variables|Default|SetCP a_CP))
  (bind days (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_Day.BP_Day_C"))
  (for d days (Variables|Default|SetDayRef d))
  (bind chs (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_Chores.BP_Chores_C"))
  (for c chs (Variables|Default|SetChoreRef c))
  (bind sts (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_Story.BP_Story_C"))
  (for st0 sts (Variables|Default|SetStoryRef st0)))

(event UserInterface|EventTick (MyGeometry InDeltaTime)
  (bind cbl (Transformation|GetActorLocation :self (Variables|Default|GetCB)))
  (bind dbl (Transformation|GetActorLocation :self (Variables|Default|GetDB)))
  (bind cpl (Transformation|GetActorLocation :self (Variables|Default|GetCP)))
  (bind active (> (.y cbl) 0.5))
  (bind over (> (.z dbl) 0.5))
  (bind day (Variables|Default|GetDayRef))
  (bind ch (Variables|Default|GetChoreRef))
  (bind daylen (Class|BPDay|GetDayLen :self day))
  (if (Game|Player|WasInputKeyJustPressed :self (Widget|GetOwningPlayer) :Key "F6") (Variables|Default|SetShowLog (not (Variables|Default|GetShowLog))))
  (if (and over (not (Variables|Default|GetWasOver))) (Variables|Default|SetWasOver true) (Variables|Default|SetShowLog true))
  (bind st (Variables|Default|GetStoryRef))
  (bind sday (Class|BPStory|GetDay :self st))
  (if (and active (or (== sday 0) (and (and (>= sday 2) (<= sday 4)) (== (Class|BPStory|GetPhase :self st) 1)))) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetChoreBox) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetChoreBox) :InVisibility "Collapsed")))
  (if (and active (Variables|Default|GetShowLog)) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetLogBox) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetLogBox) :InVisibility "Collapsed")))
  (if (and over (== sday 0)) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetDayOver) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetDayOver) :InVisibility "Collapsed")))
  (if (== sday 0) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetClock) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetClock) :InVisibility "Collapsed")))
  (if (> (Class|BPStory|GetCardT :self st) 0.0) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCard) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCard) :InVisibility "Collapsed")))
  (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetCard) :InText (Utilities|Text|ToText(String) :InString (Class|BPStory|GetCard :self st)))
  (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetNote) :InText (Utilities|Text|ToText(String) :InString (Utilities|String|Append :A (Class|BPStory|GetNote :self st) :B (select (Class|BPStory|GetLoopOn :self st) (Utilities|String|Append :A (Utilities|String|Append :A "     something changed: go back the way you came. nothing changed: keep going.   " :B (Utilities|String|ToString(Integer) :InInt (Class|BPStory|GetCount :self st))) :B (Utilities|String|Append :A " of " :B (Utilities|String|ToString(Integer) :InInt (Class|BPStory|GetNeed :self st)))) ""))))
  (if (or (== sday 0) (== sday 3)) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh0) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh0) :InVisibility "Collapsed"))) (if (or (== sday 0) (== sday 4)) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh1) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh1) :InVisibility "Collapsed"))) (if (or (== sday 0) (== sday 2)) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh2) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh2) :InVisibility "Collapsed"))) (if (or (== sday 0) (== sday 2)) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh3) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh3) :InVisibility "Collapsed"))) (if (or (== sday 0) (== sday 2)) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh4) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh4) :InVisibility "Collapsed"))) (if (or (== sday 0) (== sday 3)) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh5) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh5) :InVisibility "Collapsed"))) (if (or (== sday 0) (== sday 4)) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh6) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh6) :InVisibility "Collapsed"))) (if (or (== sday 0) (== sday 3)) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh7) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh7) :InVisibility "Collapsed"))) (if (or (== sday 0) (== sday 2)) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh8) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCh8) :InVisibility "Collapsed")))
  (bind now (Utilities|Time|GetGameTimeinSeconds))
  (bind cap (Math|Float|Round :A (.x cpl)))
  (if (and (> (.z cpl) 0.5) (and (> cap 0) (< (- now (.y cpl)) 3.5))) (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCaption) :InVisibility "HitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_Overlay|GetCaption) :InVisibility "Collapsed")))
  (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetCaption) :InText (Utilities|Text|ToText(String) :InString (select (== cap 0) "" (select (== cap 1) "[lawn mower running]" (select (== cap 2) "[washing machine running]" (select (== cap 3) "[buzzer]" (select (== cap 4) "[water pouring]" (select (== cap 5) "[dishes clink in the sink]" (select (== cap 6) "[the house groans]" (select (== cap 7) "[a breaker clunks; the power hums]" (select (== cap 8) "[doorbell]" (select (== cap 9) "[knocking at the front door]" (select (== cap 10) "[a phone rings]" (select (== cap 11) "[answering machine beeps]" (select (== cap 12) "[television static]" (select (== cap 13) "[pipes knock]" (select (== cap 14) "[a floorboard creaks]" "[footsteps overhead]")))))))))))))))))
  (if active
    (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetClock) :InText (Utilities|Text|ToText(String) :InString (Utilities|String|Append :A (Utilities|String|Append :A (Utilities|String|ToString(Integer) :InInt (Math|Float|Truncate :A (/ (+ 480.0 (* (/ (.y dbl) daylen) 600.0)) 60.0))) :B ":") :B (Utilities|String|Append :A (select (< (Math|Float|Truncate :A (- (+ 480.0 (* (/ (.y dbl) daylen) 600.0)) (* 60.0 (Math|Conversions|ToFloat(Integer) (Math|Float|Truncate :A (/ (+ 480.0 (* (/ (.y dbl) daylen) 600.0)) 60.0)))))) 10) "0" "") :B (Utilities|String|ToString(Integer) :InInt (Math|Float|Truncate :A (- (+ 480.0 (* (/ (.y dbl) daylen) 600.0)) (* 60.0 (Math|Conversions|ToFloat(Integer) (Math|Float|Truncate :A (/ (+ 480.0 (* (/ (.y dbl) daylen) 600.0)) 60.0)))))))))))
    (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetCh0) :InText (Utilities|Text|ToText(String) :InString (Utilities|String|Append :A (select (Class|BPChores|GetD0 :self ch) "[x]  " "[  ]  ") :B "Mow the back lawn")))
    (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetCh1) :InText (Utilities|Text|ToText(String) :InString (Utilities|String|Append :A (select (Class|BPChores|GetD1 :self ch) "[x]  " "[  ]  ") :B "Take out the trash, bin to the curb")))
    (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetCh2) :InText (Utilities|Text|ToText(String) :InString (Utilities|String|Append :A (select (Class|BPChores|GetD2 :self ch) "[x]  " "[  ]  ") :B "Get the mail")))
    (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetCh3) :InText (Utilities|Text|ToText(String) :InString (Utilities|String|Append :A (select (Class|BPChores|GetD3 :self ch) "[x]  " "[  ]  ") :B "Do the dishes")))
    (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetCh4) :InText (Utilities|Text|ToText(String) :InString (Utilities|String|Append :A (select (Class|BPChores|GetD4 :self ch) "[x]  " "[  ]  ") :B "Run the laundry (washer, then dryer)")))
    (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetCh5) :InText (Utilities|Text|ToText(String) :InString (Utilities|String|Append :A (select (Class|BPChores|GetD5 :self ch) "[x]  " "[  ]  ") :B "Water the garden bed")))
    (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetCh6) :InText (Utilities|Text|ToText(String) :InString (Utilities|String|Append :A (select (Class|BPChores|GetD6 :self ch) "[x]  " "[  ]  ") :B "Sweep the garage")))
    (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetCh7) :InText (Utilities|Text|ToText(String) :InString (Utilities|String|Append :A (select (Class|BPChores|GetD7 :self ch) "[x]  " "[  ]  ") :B "Change the hall light bulb")))
    (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetCh8) :InText (Utilities|Text|ToText(String) :InString (Utilities|String|Append :A (select (Class|BPChores|GetD8 :self ch) "[x]  " "[  ]  ") :B "Make the bed in Jack's room"))))
  (if (and active (Variables|Default|GetShowLog))
    (bind order (Class|BPDay|GetFiredOrder :self day))
    (bind times (Class|BPDay|GetFiredTime :self day))
    (bind seen (Class|BPDay|GetSeen :self day))
    (bind names (Class|BPDay|GetNames :self day))
    (bind n (Utilities|Array|Length :TargetArray order))
    (if (> n 0) (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetLg0) :InText (Utilities|Text|ToText(String) :InString (Utilities|String|Append :A (Utilities|String|Append :A (Utilities|String|Append :A (Utilities|String|Append :A (Utilities|String|ToString(Integer) :InInt (Math|Float|Truncate :A (/ (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 0) daylen) 600.0)) 60.0))) :B ":") :B (Utilities|String|Append :A (select (< (Math|Float|Truncate :A (- (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 0) daylen) 600.0)) (* 60.0 (Math|Conversions|ToFloat(Integer) (Math|Float|Truncate :A (/ (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 0) daylen) 600.0)) 60.0)))))) 10) "0" "") :B (Utilities|String|ToString(Integer) :InInt (Math|Float|Truncate :A (- (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 0) daylen) 600.0)) (* 60.0 (Math|Conversions|ToFloat(Integer) (Math|Float|Truncate :A (/ (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 0) daylen) 600.0)) 60.0))))))))) :B "    ") :B (Utilities|String|Append :A (Utilities|Array|Get(acopy) :Array names :"Dimension 1" (Utilities|Array|Get(acopy) :Array order :"Dimension 1" 0)) :B (select (Utilities|Array|Get(acopy) :Array seen :"Dimension 1" (Utilities|Array|Get(acopy) :Array order :"Dimension 1" 0)) "     -  looked at since: yes" "     -  looked at since: no"))))) (else (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetLg0) :InText (Utilities|Text|ToText(String) :InString ""))))
    (if (> n 1) (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetLg1) :InText (Utilities|Text|ToText(String) :InString (Utilities|String|Append :A (Utilities|String|Append :A (Utilities|String|Append :A (Utilities|String|Append :A (Utilities|String|ToString(Integer) :InInt (Math|Float|Truncate :A (/ (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 1) daylen) 600.0)) 60.0))) :B ":") :B (Utilities|String|Append :A (select (< (Math|Float|Truncate :A (- (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 1) daylen) 600.0)) (* 60.0 (Math|Conversions|ToFloat(Integer) (Math|Float|Truncate :A (/ (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 1) daylen) 600.0)) 60.0)))))) 10) "0" "") :B (Utilities|String|ToString(Integer) :InInt (Math|Float|Truncate :A (- (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 1) daylen) 600.0)) (* 60.0 (Math|Conversions|ToFloat(Integer) (Math|Float|Truncate :A (/ (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 1) daylen) 600.0)) 60.0))))))))) :B "    ") :B (Utilities|String|Append :A (Utilities|Array|Get(acopy) :Array names :"Dimension 1" (Utilities|Array|Get(acopy) :Array order :"Dimension 1" 1)) :B (select (Utilities|Array|Get(acopy) :Array seen :"Dimension 1" (Utilities|Array|Get(acopy) :Array order :"Dimension 1" 1)) "     -  looked at since: yes" "     -  looked at since: no"))))) (else (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetLg1) :InText (Utilities|Text|ToText(String) :InString ""))))
    (if (> n 2) (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetLg2) :InText (Utilities|Text|ToText(String) :InString (Utilities|String|Append :A (Utilities|String|Append :A (Utilities|String|Append :A (Utilities|String|Append :A (Utilities|String|ToString(Integer) :InInt (Math|Float|Truncate :A (/ (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 2) daylen) 600.0)) 60.0))) :B ":") :B (Utilities|String|Append :A (select (< (Math|Float|Truncate :A (- (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 2) daylen) 600.0)) (* 60.0 (Math|Conversions|ToFloat(Integer) (Math|Float|Truncate :A (/ (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 2) daylen) 600.0)) 60.0)))))) 10) "0" "") :B (Utilities|String|ToString(Integer) :InInt (Math|Float|Truncate :A (- (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 2) daylen) 600.0)) (* 60.0 (Math|Conversions|ToFloat(Integer) (Math|Float|Truncate :A (/ (+ 480.0 (* (/ (Utilities|Array|Get(acopy) :Array times :"Dimension 1" 2) daylen) 600.0)) 60.0))))))))) :B "    ") :B (Utilities|String|Append :A (Utilities|Array|Get(acopy) :Array names :"Dimension 1" (Utilities|Array|Get(acopy) :Array order :"Dimension 1" 2)) :B (select (Utilities|Array|Get(acopy) :Array seen :"Dimension 1" (Utilities|Array|Get(acopy) :Array order :"Dimension 1" 2)) "     -  looked at since: yes" "     -  looked at since: no"))))) (else (Widget|SetText(Text) :self (Variables|WBP_Overlay|GetLg2) :InText (Utilities|Text|ToText(String) :InString ""))))
