(event EventBeginPlay
  (bind f_CP (Actor|GetAllActorswithTag :Tag "cp")) (for a_CP f_CP (Variables|Default|SetCP a_CP))
  (bind f_D (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_Day.BP_Day_C")) (for a_D f_D (Variables|Default|SetDayRef a_D))
  (Variables|Default|SetNextT 40.0))

(event EventTick (DeltaSeconds)
  (if (> (Variables|Default|GetFlickT) 0.0)
    (Variables|Default|SetFlickT (- (Variables|Default|GetFlickT) DeltaSeconds))
    (if (<= (Variables|Default|GetFlickT) 0.0)
      (bind sws2 (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_Switch.BP_Switch_C"))
      (for sw2 sws2 (Class|BPSwitch|SetShown :self sw2 :Shown -1))))
  (bind dr (Variables|Default|GetDayRef))
  (if (and (Class|BPDay|GetRunning :self dr) (not (Class|BPDay|GetOver :self dr)))
    (bind t (+ (Variables|Default|GetT) DeltaSeconds))
    (Variables|Default|SetT t)
    (if (> t (Variables|Default|GetNextT))
      (Variables|Default|SetNextT (+ t 4.0))
      (bind pcm (Game|GetPlayerCameraManager :PlayerIndex 0))
      (bind camLoc (Camera|GetCameraLocation :self pcm))
      (bind now (Utilities|Time|GetGameTimeinSeconds))
      (bind cpl (Transformation|GetActorLocation :self (Variables|Default|GetCP)))
      (bind spots (Variables|Default|GetSpots))
      (bind spot (Utilities|Array|Get(acopy) :Array spots :"Dimension 1" (Math|Random|RandomIntegerinRange :Min 0 :Max (- (Utilities|Array|Length :TargetArray spots) 1))))
      (switch int (Math|Random|RandomIntegerinRange :Min 0 :Max 14)
                (:0 (if (> (Math|Vector|VectorLength :A (- (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFixed) :"Dimension 1" 0) camLoc)) 600.0)
          (Audio|PlaySoundatLocation :Sound "/Game/Audio/doorbell.doorbell" :Location (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFixed) :"Dimension 1" 0) :VolumeMultiplier 0.9 :AttenuationSettings "/Game/Audio/ATT_House.ATT_House")
          (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 8.0 :Y now :Z (.z cpl)))
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))))
        (:1 (if (> (Math|Vector|VectorLength :A (- (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFixed) :"Dimension 1" 0) camLoc)) 600.0)
          (Audio|PlaySoundatLocation :Sound "/Game/Audio/door_knock.door_knock" :Location (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFixed) :"Dimension 1" 0) :VolumeMultiplier 0.9 :AttenuationSettings "/Game/Audio/ATT_House.ATT_House")
          (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 9.0 :Y now :Z (.z cpl)))
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))))
        (:2 (if (> (Math|Vector|VectorLength :A (- (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFixed) :"Dimension 1" 1) camLoc)) 600.0)
          (Audio|PlaySoundatLocation :Sound "/Game/Audio/phone_ring.phone_ring" :Location (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFixed) :"Dimension 1" 1) :VolumeMultiplier 0.8 :AttenuationSettings "/Game/Audio/ATT_House.ATT_House")
          (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 10.0 :Y now :Z (.z cpl)))
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))))
        (:3 (if (> (Math|Vector|VectorLength :A (- (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFixed) :"Dimension 1" 1) camLoc)) 600.0)
          (Audio|PlaySoundatLocation :Sound "/Game/Audio/machine_beep.machine_beep" :Location (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFixed) :"Dimension 1" 1) :VolumeMultiplier 0.7 :AttenuationSettings "/Game/Audio/ATT_House.ATT_House")
          (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 11.0 :Y now :Z (.z cpl)))
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))))
        (:4 (if (> (Math|Vector|VectorLength :A (- (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFixed) :"Dimension 1" 2) camLoc)) 600.0)
          (Audio|PlaySoundatLocation :Sound "/Game/Audio/tv_burst.tv_burst" :Location (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFixed) :"Dimension 1" 2) :VolumeMultiplier 0.7 :AttenuationSettings "/Game/Audio/ATT_House.ATT_House")
          (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 12.0 :Y now :Z (.z cpl)))
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))))
        (:5 (if (> (Math|Vector|VectorLength :A (- spot camLoc)) 600.0)
          (Audio|PlaySoundatLocation :Sound "/Game/Audio/pipe_knock.pipe_knock" :Location spot :VolumeMultiplier 0.9 :AttenuationSettings "/Game/Audio/ATT_House.ATT_House")
          (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 13.0 :Y now :Z (.z cpl)))
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))))
        (:6 (if (> (Math|Vector|VectorLength :A (- spot camLoc)) 600.0)
          (Audio|PlaySoundatLocation :Sound "/Game/Audio/floor_creak.floor_creak" :Location spot :VolumeMultiplier 0.9 :AttenuationSettings "/Game/Audio/ATT_House.ATT_House")
          (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 14.0 :Y now :Z (.z cpl)))
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))))
        (:7 (if (> (Math|Vector|VectorLength :A (- spot camLoc)) 600.0)
          (Audio|PlaySoundatLocation :Sound "/Game/Audio/steps_above.steps_above" :Location spot :VolumeMultiplier 1.0 :AttenuationSettings "/Game/Audio/ATT_House.ATT_House")
          (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 15.0 :Y now :Z (.z cpl)))
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))))
        (:8 (if (> (Math|Vector|VectorLength :A (- spot camLoc)) 600.0)
          (Audio|PlaySoundatLocation :Sound "/Game/Audio/floor_creak.floor_creak" :Location spot :VolumeMultiplier 0.7 :AttenuationSettings "/Game/Audio/ATT_House.ATT_House")
          (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 14.0 :Y now :Z (.z cpl)))
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))))
        (:9 (if (> (Math|Vector|VectorLength :A (- spot camLoc)) 600.0)
          (Audio|PlaySoundatLocation :Sound "/Game/Audio/pipe_knock.pipe_knock" :Location spot :VolumeMultiplier 0.7 :AttenuationSettings "/Game/Audio/ATT_House.ATT_House")
          (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 13.0 :Y now :Z (.z cpl)))
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))))
        (:10 (if (> (Math|Vector|VectorLength :A (- (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFixed) :"Dimension 1" 3) camLoc)) 600.0)
          (Audio|PlaySoundatLocation :Sound "/Game/Audio/gravel_steps.gravel_steps" :Location (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFixed) :"Dimension 1" 3) :VolumeMultiplier 1.0 :AttenuationSettings "/Game/Audio/ATT_House.ATT_House")
          (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 16.0 :Y now :Z (.z cpl)))
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))))
        (:11 (if (> (Math|Vector|VectorLength :A (- (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFixed) :"Dimension 1" 0) camLoc)) 600.0)
          (Audio|PlaySoundatLocation :Sound "/Game/Audio/porch_creak.porch_creak" :Location (Utilities|Array|Get(acopy) :Array (Variables|Default|GetFixed) :"Dimension 1" 0) :VolumeMultiplier 0.9 :AttenuationSettings "/Game/Audio/ATT_House.ATT_House")
          (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 17.0 :Y now :Z (.z cpl)))
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))))
        (:12 (if (> (Math|Vector|VectorLength :A (- spot camLoc)) 600.0)
          (Audio|PlaySoundatLocation :Sound "/Game/Audio/door_close.door_close" :Location spot :VolumeMultiplier 1.0 :AttenuationSettings "/Game/Audio/ATT_House.ATT_House")
          (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 18.0 :Y now :Z (.z cpl)))
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))))
        (:13 (if (> (Math|Vector|VectorLength :A (- spot camLoc)) 600.0)
          (Audio|PlaySoundatLocation :Sound "/Game/Audio/water_drip.water_drip" :Location spot :VolumeMultiplier 0.8 :AttenuationSettings "/Game/Audio/ATT_House.ATT_House")
          (Transformation|SetActorLocation :self (Variables|Default|GetCP) :NewLocation (Math|Vector|MakeVector :X 19.0 :Y now :Z (.z cpl)))
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax))))))
        ; the lights near him dip: every lit lamp within 7 m goes dark for a third of a second (its switch puts it back)
        (:14 (bind sws (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_Switch.BP_Switch_C"))
          (for sw sws
            (if (and (Class|BPSwitch|GetOn :self sw) (< (Math|Vector|VectorLength :A (- (Transformation|GetActorLocation :self sw) camLoc)) 700.0))
              (bind grp (Actor|GetAllActorswithTag :Tag (Class|BPSwitch|GetGroup :self sw)))
              (for ga grp (Rendering|SetActorHiddenInGame :self ga :bNewHidden true))))
          (Variables|Default|SetFlickT 0.33)
          (Variables|Default|SetNextT (+ t (Math|Random|RandomFloatinRange :Min (Variables|Default|GetGapMin) :Max (Variables|Default|GetGapMax)))))))))
