(event EventBeginPlay
  (bind f_UB (Actor|GetAllActorswithTag :Tag "ub")) (for a_UB f_UB (Variables|Default|SetUB a_UB)) (bind f_CB (Actor|GetAllActorswithTag :Tag "cb")) (for a_CB f_CB (Variables|Default|SetCB a_CB)) (bind f_LB (Actor|GetAllActorswithTag :Tag "lb")) (for a_LB f_LB (Variables|Default|SetLB a_LB)) (bind f_QB (Actor|GetAllActorswithTag :Tag "qb")) (for a_QB f_QB (Variables|Default|SetQB a_QB))
  (bind f_Bed (Actor|GetAllActorswithTag :Tag "ch_bed")) (for a_Bed f_Bed (Variables|Default|SetBed a_Bed)) (bind f_BoxA (Actor|GetAllActorswithTag :Tag "s_boxa")) (for a_BoxA f_BoxA (Variables|Default|SetBoxA a_BoxA)) (bind f_BoxB (Actor|GetAllActorswithTag :Tag "s_boxb")) (for a_BoxB f_BoxB (Variables|Default|SetBoxB a_BoxB)) (bind f_OpenA (Actor|GetAllActorswithTag :Tag "st_open_a")) (for a_OpenA f_OpenA (Variables|Default|SetOpenA a_OpenA)) (bind f_OpenB (Actor|GetAllActorswithTag :Tag "st_open_b")) (for a_OpenB f_OpenB (Variables|Default|SetOpenB a_OpenB))
  (bind f_Keep (Actor|GetAllActorswithTag :Tag "st_keepsake")) (for a_Keep f_Keep (Variables|Default|SetKeep a_Keep)) (bind f_Albums (Actor|GetAllActorswithTag :Tag "st_albums")) (for a_Albums f_Albums (Variables|Default|SetAlbums a_Albums)) (bind f_Tape (Actor|GetAllActorswithTag :Tag "st_tape")) (for a_Tape f_Tape (Variables|Default|SetTape a_Tape)) (bind f_Photo (Actor|GetAllActorswithTag :Tag "st_photo")) (for a_Photo f_Photo (Variables|Default|SetPhoto a_Photo)) (bind f_Climax (Actor|GetAllActorswithTag :Tag "st_climax")) (for a_Climax f_Climax (Variables|Default|SetClimax a_Climax)) (bind f_Shelf (Actor|GetAllActorswithTag :Tag "st_shelf")) (for a_Shelf f_Shelf (Variables|Default|SetShelf a_Shelf))
  (bind t_HudRef (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_HUD.BP_HUD_C")) (for b_HudRef t_HudRef (Variables|Default|SetHudRef b_HudRef)) (bind t_LoopRef (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_Loop.BP_Loop_C")) (for b_LoopRef t_LoopRef (Variables|Default|SetLoopRef b_LoopRef)) (bind t_DayRef (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_Day.BP_Day_C")) (for b_DayRef t_DayRef (Variables|Default|SetDayRef b_DayRef)) (bind t_ChoreRef (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_Chores.BP_Chores_C")) (for b_ChoreRef t_ChoreRef (Variables|Default|SetChoreRef b_ChoreRef)) (bind t_PlayerRef (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_Player.BP_Player_C")) (for b_PlayerRef t_PlayerRef (Variables|Default|SetPlayerRef b_PlayerRef)) (bind t_FrontRef (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_Front.BP_Front_C")) (for b_FrontRef t_FrontRef (Variables|Default|SetFrontRef b_FrontRef))
  (bind ents (Actor|GetAllActorswithTag :Tag "ent"))
  (for e ents (Actor|Tick|SetActorTickEnabled :self e :bEnabled false))
  (if (not (SaveGame|DoesSaveGameExist :SlotName "progress" :UserIndex 0))
    (SaveGame|SaveGametoSlot :SaveGameObject (SaveGame|CreateSaveGameObject :SaveGameClass "/Game/Blueprints/BP_SaveSettings.BP_SaveSettings_C") :SlotName "progress" :UserIndex 0))
  (bind sv0 (Utilities|Casting|CastToBP_SaveSettings :Object (SaveGame|LoadGamefromSlot :SlotName "progress" :UserIndex 0))
    (:then (Variables|Default|SetSave sv0)
           (if (> (Class|BPSaveSettings|GetStartDay :self sv0) 0)
             (Variables|Default|SetStartReq (Class|BPSaveSettings|GetStartDay :self sv0))
             (Class|BPSaveSettings|SetStartDay :self sv0 :StartDay 0)
             (SaveGame|SaveGametoSlot :SaveGameObject sv0 :SlotName "progress" :UserIndex 0)))
    (:CastFailed)))

(event EventTick (DeltaSeconds)
  (bind hud (Variables|Default|GetHudRef))
  (bind lp (Variables|Default|GetLoopRef))
  (bind dc (Variables|Default|GetDayRef))
  (bind ch (Variables|Default|GetChoreRef))
  (bind pl (Variables|Default|GetPlayerRef))
  (bind sv (Variables|Default|GetSave))
  (bind pc (Game|GetPlayerController :PlayerIndex 0))
  (bind ploc (Transformation|GetActorLocation :self pl))
  (bind mode (Class|BPHUD|GetMode :self hud))
  (Variables|Default|SetP0 (Variables|Default|GetPhase))
  (bind p0 (Variables|Default|GetP0))
  (bind day (Variables|Default|GetDay))
  (bind t (+ (Variables|Default|GetT) DeltaSeconds))
  (Variables|Default|SetT t)
  (bind use (or (Variables|Default|GetTestUse) (and (Game|Player|WasInputKeyJustPressed :self pc :Key (Class|BPPlayer|GetKUse :self pl)) (not (Input|IsMoveInputIgnored :self pc)))))
  ; ---------------- chapter select / continue: the menu leaves a day number on the request board ----------------
  (bind qbl (Transformation|GetActorLocation :self (Variables|Default|GetQB)))
  (if (> (.x qbl) 0.5)
    (Transformation|SetActorLocation :self (Variables|Default|GetQB) :NewLocation (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 0.0))
    (if (== mode 0)
      (Variables|Default|SetStartReq (select (> (.x qbl) 8.5) (Math|Integer|Max(Integer) :A 1 :B (Class|BPSaveSettings|GetDay :self sv)) (Math|Float|Round :A (.x qbl))))
      (else
        ; a day picked in the middle of a game: remember it, and start the level again from clean
        (Class|BPSaveSettings|SetStartDay :self sv :StartDay (Math|Float|Round :A (.x qbl)))
        (SaveGame|SaveGametoSlot :SaveGameObject sv :SlotName "progress" :UserIndex 0)
        (Game|OpenLevel(byName) :LevelName "POC_VisualSlice"))))
  (bind req (Variables|Default|GetStartReq))
  (if (and (> req 0) (> (Utilities|Time|GetGameTimeinSeconds) 0.5))
    (Variables|Default|SetStartReq 0)
    (if (== req 1)
      (Transformation|SetActorLocation :self (Variables|Default|GetUB) :NewLocation (Math|Vector|MakeVector :X 1.0 :Y 1.0 :Z 1.0))
      (else
        (Class|BPFront|SetChoreStart :self (Variables|Default|GetFrontRef) :ChoreStart true)
        (Variables|Default|SetDay (- req 1)) (Variables|Default|SetPhase 10) (Variables|Default|SetT 0.0) (Variables|Default|SetWoke false)
        (Class|BPHUD|SetFade :self hud :Fade 1.0) (Class|BPHUD|SetFadeTarget :self hud :FadeTarget 1.0))))
  ; ---------------- day 1 is the director's own Day One; it becomes ours when he lies down ----------------
  (if (and (== day 0) (or (== mode 5) (== mode 1))) (Variables|Default|SetDay 1) (Variables|Default|SetPhase 1))
  (if (and (== day 1) (and (== mode 3) (not (Variables|Default|GetLay))))
    ; he lies down on his own bed (the director still thinks the bed is where it was in the small house)
    (Variables|Default|SetLay true)
    (Transformation|SetActorLocation :self pl :NewLocation (Math|Vector|MakeVector :X 530.0 :Y -410.0 :Z 418.0)))
  (if (and (== day 1) (and (== mode 3) (>= (Class|BPHUD|GetStep :self hud) 1)))
    (Class|BPHUD|SetMode :self hud :Mode 8) (Class|BPHUD|SetFadeTarget :self hud :FadeTarget 1.0) (Class|BPHUD|SetPower :self hud :Power true)
    (bind cbl0 (Transformation|GetActorLocation :self (Variables|Default|GetCB)))
    (Transformation|SetActorLocation :self (Variables|Default|GetCB) :NewLocation (Math|Vector|MakeVector :X (.x cbl0) :Y 1.0 :Z (.z cbl0)))
    (Variables|Default|SetPhase 10) (Variables|Default|SetT 0.0) (Variables|Default|SetWoke false))
  (if (>= day 2)
    ; unease climbs through the day; the day's anomalies keep their own pace
    (bind prog (Math|Float|Clamp(Float) :Value (/ (Variables|Default|GetDayT) 420.0) :Min 0.0 :Max 1.0))
    (Variables|Default|SetDayT (+ (Variables|Default|GetDayT) DeltaSeconds))
    (if (and (< p0 7) (!= p0 10))
      (Class|BPHUD|SetTarget :self hud :Target (+ (select (== day 2) 10 (select (== day 3) 30 (select (== day 4) 50 80))) (* prog (- (select (== day 2) 30 (select (== day 3) 50 (select (== day 4) 80 100))) (select (== day 2) 10 (select (== day 3) 30 (select (== day 4) 50 80))))))))
    (Class|BPDay|SetOver :self dc :Over false))
  ; ---------------- night: fade, the day card, autosave, wake beside the bed ----------------
  (if (== p0 10)
    (if (and (> t 2.5) (not (Variables|Default|GetWoke)))
      (Variables|Default|SetWoke true)
      (Variables|Default|SetDay (+ day 1))
      (Variables|Default|SetDayT 0.0)
      (Variables|Default|SetCard (select (== day 2) "Day 2   -   Settling in" (select (== day 3) "Day 3   -   Things move" (select (== day 4) "Day 4   -   Losing grip" "Day 5   -   Facing it"))))
      (Variables|Default|SetCardT 4.5)
      (Class|BPSaveSettings|SetDay :self sv :Day day)
      (SaveGame|SaveGametoSlot :SaveGameObject sv :SlotName "progress" :UserIndex 0)
      (Class|BPDay|SetT :self dc :T 0.0) (Class|BPDay|SetDayLen :self dc :DayLen 600.0)
      (Transformation|SetActorLocation :self pl :NewLocation (Math|Vector|MakeVector :X 450.0 :Y -330.0 :Z 351.0))
      (Pawn|SetControlRotation :self pc :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch 0.0 :Yaw 180.0))
      (Collision|SetActorEnableCollision :self pl :bNewActorEnableCollision true))
    (if (> t 7.0)
      (Class|BPHUD|SetFadeSpeed :self hud :FadeSpeed 0.5) (Class|BPHUD|SetFadeTarget :self hud :FadeTarget 0.0)
      (Input|ResetIgnoreMoveInput :self pc) (Input|ResetIgnoreLookInput :self pc)
      (Class|BPDay|SetGapMin :self dc :GapMin (select (== day 2) 70.0 (select (== day 3) 45.0 (select (== day 4) 30.0 25.0))))
      (Class|BPDay|SetGapMax :self dc :GapMax (select (== day 2) 120.0 (select (== day 3) 80.0 (select (== day 4) 60.0 45.0))))
      (bind e2 (Actor|GetAllActorswithTag :Tag "ent2"))
      (for a2 e2 (Actor|Tick|SetActorTickEnabled :self a2 :bEnabled true))
      (if (>= day 3) (bind e3 (Actor|GetAllActorswithTag :Tag "ent3")) (for a3 e3 (Actor|Tick|SetActorTickEnabled :self a3 :bEnabled true)))
      (if (>= day 4) (bind e4 (Actor|GetAllActorswithTag :Tag "ent4")) (for a4 e4 (Actor|Tick|SetActorTickEnabled :self a4 :bEnabled true)))
      (Variables|Default|SetNote (select (== day 2) "the list. start with the bed." (select (== day 3) "more to do. the yard." (select (== day 4) "there was something you were going to do." "stay. no. go upstairs."))))
      (Variables|Default|SetPhase 1) (Variables|Default|SetT 0.0)))
  ; ---------------- phase 1: the day's chores ----------------
  (if (and (== p0 1) (>= day 2))
    (if (and (and (and (and (and (and (and (and (and true (or (!= day 3) (Class|BPChores|GetD0 :self ch))) (or (!= day 4) (Class|BPChores|GetD1 :self ch))) (or (!= day 2) (Class|BPChores|GetD2 :self ch))) (or (!= day 2) (Class|BPChores|GetD3 :self ch))) (or (!= day 2) (Class|BPChores|GetD4 :self ch))) (or (!= day 3) (Class|BPChores|GetD5 :self ch))) (or (!= day 4) (Class|BPChores|GetD6 :self ch))) (or (!= day 3) (Class|BPChores|GetD7 :self ch))) (or (!= day 2) (Class|BPChores|GetD8 :self ch)))
      (Variables|Default|SetT 0.0)
      (if (== day 2)
        (Variables|Default|SetPhase 5) (Variables|Default|SetNote "that is everything. go to bed.")
        (else
          (Variables|Default|SetPhase 2)
          (Variables|Default|SetNote (select (== day 3) "the closet at the end of the upstairs hall is open." "something upstairs is wrong. the closet."))
          (if (== day 3) (Variables|Default|SetNeed 1) (Variables|Default|SetLoopOn true) (Class|BPLoop|SetStreak :self lp :Streak 0) (Class|BPLoop|SetWas :self lp :Was false) (Transformation|SetActorLocation :self (Variables|Default|GetLB) :NewLocation (Math|Vector|MakeVector :X 1.0 :Y 0.0 :Z 0.0)) (Audio|PlaySound2D :Sound "/Game/Audio/house_groan.house_groan" :VolumeMultiplier 0.35) (else (if (== day 4) (Variables|Default|SetNeed 3) (Variables|Default|SetLoopOn true) (Class|BPLoop|SetStreak :self lp :Streak 0) (Class|BPLoop|SetWas :self lp :Was false) (Transformation|SetActorLocation :self (Variables|Default|GetLB) :NewLocation (Math|Vector|MakeVector :X 1.0 :Y 0.0 :Z 0.0)) (Audio|PlaySound2D :Sound "/Game/Audio/house_groan.house_groan" :VolumeMultiplier 0.35) (else (Variables|Default|SetNeed 5) (Variables|Default|SetLoopOn true) (Class|BPLoop|SetStreak :self lp :Streak 0) (Class|BPLoop|SetWas :self lp :Was false) (Transformation|SetActorLocation :self (Variables|Default|GetLB) :NewLocation (Math|Vector|MakeVector :X 1.0 :Y 0.0 :Z 0.0)) (Audio|PlaySound2D :Sound "/Game/Audio/house_groan.house_groan" :VolumeMultiplier 0.35)))))))))
  ; ---------------- the corridor loop: it runs until he has made enough right calls and is back in the hall ----------------
  (if (Variables|Default|GetLoopOn)
    (bind lbl (Transformation|GetActorLocation :self (Variables|Default|GetLB)))
    (Variables|Default|SetCount (Math|Float|Round :A (.y lbl)))
    (if (and (>= (.y lbl) (Math|Conversions|ToFloat(Integer) (Variables|Default|GetNeed))) (> (.y ploc) -600.0))
      (Variables|Default|SetLoopOn false)
      (bind doors (Actor|GetAllActorsOfClass :ActorClass "/Game/Blueprints/BP_Mover.BP_Mover_C"))
      (for d doors
        (if (and (Class|BPMover|GetLoopKey :self d) (Class|BPMover|GetOpen :self d)) (Game|Damage|ApplyDamage :DamagedActor d :BaseDamage 1.0)))
      (Transformation|SetActorLocation :self (Variables|Default|GetLB) :NewLocation (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 0.0))
      (bind ax (Actor|GetAllActorswithTag :Tag "annex"))
      (for a ax (Rendering|SetActorHiddenInGame :self a :bNewHidden true) (Collision|SetActorEnableCollision :self a :bNewActorEnableCollision false))
      (bind axh (Actor|GetAllActorswithTag :Tag "annex_hide"))
      (for h axh (Rendering|SetActorHiddenInGame :self h :bNewHidden false) (Collision|SetActorEnableCollision :self h :bNewActorEnableCollision true))
      (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.6)
      (Variables|Default|SetT 0.0)
      (if (== day 3)
        ; the first time the house stretched. Afterwards their door stands open.
        (bind pd (Actor|GetAllActorsOfClasswithTag :ActorClass "/Game/Blueprints/BP_Mover.BP_Mover_C" :Tag "s_pdoor"))
        (for q pd (if (not (Class|BPMover|GetOpen :self q)) (Game|Damage|ApplyDamage :DamagedActor q :BaseDamage 1.0)))
        (Variables|Default|SetPhase 5) (Variables|Default|SetNote "their door is open. not yet. go to bed.")
        (elif (and (== day 4) (== p0 2))
          (Variables|Default|SetPhase 3) (Variables|Default|SetNote "it is not finished. the closet again.") (Variables|Default|SetNeed 3) (Variables|Default|SetLoopOn true) (Class|BPLoop|SetStreak :self lp :Streak 0) (Class|BPLoop|SetWas :self lp :Was false) (Transformation|SetActorLocation :self (Variables|Default|GetLB) :NewLocation (Math|Vector|MakeVector :X 1.0 :Y 0.0 :Z 0.0)) (Audio|PlaySound2D :Sound "/Game/Audio/house_groan.house_groan" :VolumeMultiplier 0.35)
          (elif (== day 4)
            (Variables|Default|SetPhase 5) (Variables|Default|SetNote "go to bed. please.")
            (else
              (Variables|Default|SetPhase 6) (Variables|Default|SetNote "their room. the box, the albums, the tape.")
              (bind pd5 (Actor|GetAllActorsOfClasswithTag :ActorClass "/Game/Blueprints/BP_Mover.BP_Mover_C" :Tag "s_pdoor"))
              (for q5 pd5 (if (not (Class|BPMover|GetOpen :self q5)) (Game|Damage|ApplyDamage :DamagedActor q5 :BaseDamage 1.0)))))))))
  ; ---------------- phase 5: bed ----------------
  (if (and (== p0 5) (and use (< (Math|Vector|Distance2D(Vector) :V1 ploc :V2 (Transformation|GetActorLocation :self (Variables|Default|GetBed))) 210.0)))
    (Class|BPHUD|SetFadeSpeed :self hud :FadeSpeed 0.8) (Class|BPHUD|SetFadeTarget :self hud :FadeTarget 1.0)
    (Input|SetIgnoreMoveInput :self pc :bNewMoveInput true)
    (Variables|Default|SetNote "") (Variables|Default|SetPhase 10) (Variables|Default|SetT 0.0) (Variables|Default|SetWoke false))
  ; ---------------- day 5, phase 6: the parents' room. Three things hold the last memories ----------------
  (if (== p0 6)
    (if (and use (and (not (Variables|Default|GetM0)) (< (Math|Vector|Distance2D(Vector) :V1 ploc :V2 (Transformation|GetActorLocation :self (Variables|Default|GetKeep))) 150.0)))
      (Variables|Default|SetM0 true) (Variables|Default|SetNote "hospital bracelets. three of them. mine is the smallest.") (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.4))
    (if (and use (and (not (Variables|Default|GetM1)) (< (Math|Vector|Distance2D(Vector) :V1 ploc :V2 (Transformation|GetActorLocation :self (Variables|Default|GetAlbums))) 150.0)))
      (Variables|Default|SetM1 true) (Variables|Default|SetNote "every page has the date in her handwriting. the last one is this spring.") (Audio|PlaySound2D :Sound "/Game/Audio/cloth.cloth" :VolumeMultiplier 0.5))
    (if (and use (and (not (Variables|Default|GetM2)) (< (Math|Vector|Distance2D(Vector) :V1 ploc :V2 (Transformation|GetActorLocation :self (Variables|Default|GetTape))) 150.0)))
      (Variables|Default|SetM2 true) (Variables|Default|SetNote "JACK - 5TH BIRTHDAY. he is laughing behind the camera the whole time.") (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.4))
    (if (and (Variables|Default|GetM0) (and (Variables|Default|GetM1) (Variables|Default|GetM2)))
      (Variables|Default|SetPhase 7) (Variables|Default|SetT 0.0) (Variables|Default|SetShown false)))
  ; ---------------- phase 7: the one earned moment. It waits behind him; when he faces it, it does not turn into a coat. Then it lets go ----------------
  (if (== p0 7)
    (bind pcm (Game|GetPlayerCameraManager :PlayerIndex 0))
    (bind cam (Camera|GetCameraLocation :self pcm))
    (bind fwd (Math|Vector|GetForwardVector :InRot (Camera|GetCameraRotation :self pcm)))
    (bind to (- (Transformation|GetActorLocation :self (Variables|Default|GetClimax)) cam))
    (bind dist (+ (Math|Vector|VectorLength :A to) 0.001))
    (bind ang (Math|Trig|Acos(Degrees) :A (/ (Math|Vector|DotProduct :A fwd :B to) dist)))
    (if (and (not (Variables|Default|GetShown)) (and (> t 6.0) (> ang 95.0)))
      (Variables|Default|SetShown true) (Rendering|SetActorHiddenInGame :self (Variables|Default|GetClimax) :bNewHidden false) (Variables|Default|SetT 0.0) (Variables|Default|SetLook 0.0)
      (Class|BPHUD|SetTarget :self hud :Target 100.0) (Audio|PlaySound2D :Sound "/Game/Audio/house_groan.house_groan" :VolumeMultiplier 0.55) (Variables|Default|SetNote ""))
    (if (Variables|Default|GetShown)
      (if (< ang 24.0) (Variables|Default|SetLook (+ (Variables|Default|GetLook) DeltaSeconds)))
      (if (> (Variables|Default|GetLook) 2.2)
        (Rendering|SetActorHiddenInGame :self (Variables|Default|GetClimax) :bNewHidden true)
        (Class|BPHUD|SetTarget :self hud :Target 0.0)
        (Audio|PlaySound2D :Sound "/Game/Audio/cloth.cloth" :VolumeMultiplier 0.4)
        (Variables|Default|SetNote "it was only ever me.")
        (Variables|Default|SetPhase 8) (Variables|Default|SetT 0.0))))
  ; ---------------- phase 8: the house is quiet. Unpack the two boxes; put one photo on the shelf beside theirs ----------------
  (if (== p0 8)
    (Class|BPHUD|SetTarget :self hud :Target 0.0)
    (if (and (> t 9.0) (and (not (Variables|Default|GetU0)) (not (Variables|Default|GetU1)))) (Variables|Default|SetNote "unpack. both boxes."))
    (if (and use (and (not (Variables|Default|GetU0)) (< (Math|Vector|Distance2D(Vector) :V1 ploc :V2 (Transformation|GetActorLocation :self (Variables|Default|GetBoxA))) 170.0)))
      (Variables|Default|SetU0 true) (Transformation|SetActorLocation :self (Variables|Default|GetOpenA) :NewLocation (Transformation|GetActorLocation :self (Variables|Default|GetBoxA))) (Rendering|SetActorHiddenInGame :self (Variables|Default|GetOpenA) :bNewHidden false) (Rendering|SetActorHiddenInGame :self (Variables|Default|GetBoxA) :bNewHidden true)
      (Collision|SetActorEnableCollision :self (Variables|Default|GetBoxA) :bNewActorEnableCollision false) (Audio|PlaySound2D :Sound "/Game/Audio/box_thump.box_thump" :VolumeMultiplier 0.6))
    (if (and use (and (not (Variables|Default|GetU1)) (< (Math|Vector|Distance2D(Vector) :V1 ploc :V2 (Transformation|GetActorLocation :self (Variables|Default|GetBoxB))) 170.0)))
      (Variables|Default|SetU1 true) (Transformation|SetActorLocation :self (Variables|Default|GetOpenB) :NewLocation (Transformation|GetActorLocation :self (Variables|Default|GetBoxB))) (Rendering|SetActorHiddenInGame :self (Variables|Default|GetOpenB) :bNewHidden false) (Rendering|SetActorHiddenInGame :self (Variables|Default|GetBoxB) :bNewHidden true)
      (Collision|SetActorEnableCollision :self (Variables|Default|GetBoxB) :bNewActorEnableCollision false) (Audio|PlaySound2D :Sound "/Game/Audio/box_thump.box_thump" :VolumeMultiplier 0.6))
    (if (and (Variables|Default|GetU0) (and (Variables|Default|GetU1) (not (Variables|Default|GetU2))))
      (Variables|Default|SetNote "one more thing. the shelf in the living room, next to theirs.")
      (if (and use (< (Math|Vector|Distance2D(Vector) :V1 ploc :V2 (Transformation|GetActorLocation :self (Variables|Default|GetShelf))) 190.0))
        (Variables|Default|SetU2 true) (Rendering|SetActorHiddenInGame :self (Variables|Default|GetPhoto) :bNewHidden false) (Audio|PlaySound2D :Sound "/Game/Audio/click.click" :VolumeMultiplier 0.5) (Variables|Default|SetNote "") (Variables|Default|SetT 0.0)))
    (if (and (Variables|Default|GetU2) (> t 5.0)) (Class|BPHUD|SetFadeSpeed :self hud :FadeSpeed 0.4) (Class|BPHUD|SetFadeTarget :self hud :FadeTarget 1.0))
    (if (and (Variables|Default|GetU2) (> t 9.0))
      (Class|BPHUD|SetMode :self hud :Mode 4) (Class|BPHUD|SetFadeTarget :self hud :FadeTarget 0.0) (Variables|Default|SetPhase 9)
      (Class|BPSaveSettings|SetDay :self sv :Day 1)
      (SaveGame|SaveGametoSlot :SaveGameObject sv :SlotName "progress" :UserIndex 0)))
  (Variables|Default|SetCardT (- (Variables|Default|GetCardT) DeltaSeconds))
  (Variables|Default|SetTestUse false))
